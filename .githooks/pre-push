#!/usr/bin/env bash
# Fast typecheck for each affected sub-project's own compiler config, run
# before push. Enable once per clone with: git config core.hooksPath .githooks
#
# Deliberately skips full test suites and coverage (see scripts/preflight.sh
# for those) to stay fast on routine pushes, per section 14.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

zero="0000000000000000000000000000000000000000"
changed_files=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi
    if [ "$remote_sha" = "$zero" ] || [ -z "$remote_sha" ]; then
        base=$(git merge-base "$local_sha" origin/develop 2>/dev/null || echo "$local_sha~1")
    else
        base="$remote_sha"
    fi
    files=$(git diff --name-only "$base" "$local_sha" -- . 2>/dev/null || true)
    changed_files="$changed_files
$files"
done

changed_files=$(echo "$changed_files" | sed '/^$/d' | sort -u)

if [ -z "$changed_files" ]; then
    exit 0
fi

status=0

if echo "$changed_files" | grep -qE '^ontology-vscode-extension/src/'; then
    echo "pre-push: typechecking ontology-vscode-extension (extension host)..." >&2
    (cd ontology-vscode-extension && npx tsc -p ./ --noEmit) || status=1
fi

if echo "$changed_files" | grep -qE '^ontology-vscode-extension/webview-src/'; then
    echo "pre-push: typechecking ontology-vscode-extension/webview-src..." >&2
    (cd ontology-vscode-extension/webview-src && npx tsc --noEmit) || status=1
fi

java_modules=$(echo "$changed_files" | grep -E '\.java$' | sed -E 's#^(([^/]+/)?[^/]+)/src/.*#\1#' | sort -u || true)
for module in $java_modules; do
    [ -d "$module" ] || continue
    echo "pre-push: compiling $module (Java fast typecheck proxy)..." >&2
    mvn -q -o -pl "$module" compile || status=1
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: typecheck failed, push aborted." >&2
fi

exit "$status"
