# Multi-stage build for Plugin Service
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /build

# Copy entire plugin service directory (it's standalone)
COPY ontology-plugin-service/ .

# Build the application - package goal includes spring-boot:repackage automatically
RUN --mount=type=cache,target=/root/.m2 \
    mvn -Dhttp.keepAlive=false \
        -Dmaven.wagon.http.retryHandler.count=10 \
        -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 \
        clean package -DskipTests -B -ntp

# Runtime stage
FROM eclipse-temurin:21-jre

WORKDIR /app

# Add non-root user for security
RUN if ! getent group 1000 >/dev/null; then groupadd -g 1000 appuser; else echo "Group 1000 already exists"; fi && \
    if ! getent passwd 1000 >/dev/null; then useradd -u 1000 -g 1000 -m -s /bin/bash appuser; else echo "User 1000 already exists"; fi
# Install wget for health checks
RUN apt-get update && apt-get install -y wget && rm -rf /var/lib/apt/lists/*
# Create storage directory
RUN mkdir -p /app/storage && \
    chown -R 1000:1000 /app

# Copy the built JAR (spring-boot:repackage creates executable JAR)
COPY --from=build /build/target/*.jar app.jar

USER 1000

# Expose plugin service port
EXPOSE 8087

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8087/actuator/health || exit 1

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]
