        <mxCell id="p2p-lan" edge="1" parent="1" source="desktop-a-sync-service" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;strokeWidth=6;strokeColor=#2E7D32;elbow=vertical;" target="desktop-b-sync-service" value="🚀 LAN Direct (mDNS)">
