        <mxCell id="sync-details-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#000000" value="🔄 SYNCHRONIZATION FLOW" vertex="1">
          <mxGeometry height="30" width="400" x="600" y="680" as="geometry" />
        </mxCell>
        <mxCell id="flow-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" value="1️⃣ File Change Detection&lt;br&gt;&lt;br&gt;• Developer edits .owl file&lt;br&gt;• File watcher detects change&lt;br&gt;• Calculate file hash (SHA-256)&lt;br&gt;• Generate delta (binary diff)" vertex="1">
          <mxGeometry height="110" width="240" x="100" y="740" as="geometry" />
        </mxCell>
        <mxCell id="flow-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" value="2️⃣ Peer Discovery&lt;br&gt;&lt;br&gt;• Broadcast on LAN (mDNS)&lt;br&gt;• Query relay server for WAN peers&lt;br&gt;• Establish WebSocket connections&lt;br&gt;• Verify peer identity (certificates)" vertex="1">
          <mxGeometry height="110" width="240" x="380" y="740" as="geometry" />
        </mxCell>
        <mxCell id="flow-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" value="3️⃣ Delta Transmission&lt;br&gt;&lt;br&gt;• Compress delta (zstd/brotli)&lt;br&gt;• Encrypt with TLS 1.3&lt;br&gt;• Send via WebSocket/QUIC&lt;br&gt;• Verify checksum on receipt" vertex="1">
          <mxGeometry height="110" width="240" x="660" y="740" as="geometry" />
        </mxCell>
        <mxCell id="flow-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;" value="4️⃣ Conflict Resolution&lt;br&gt;&lt;br&gt;• 3-way merge (base, local, remote)&lt;br&gt;• Use CRDT for OWL triples&lt;br&gt;• Timestamp-based ordering&lt;br&gt;• Manual resolution UI if needed" vertex="1">
          <mxGeometry height="110" width="240" x="940" y="740" as="geometry" />
        </mxCell>
        <mxCell id="flow-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;" value="5️⃣ Apply &amp; Notify&lt;br&gt;&lt;br&gt;• Apply patch to local file&lt;br&gt;• Update sync state metadata&lt;br&gt;• Trigger file reload in VS Code&lt;br&gt;• Notify user via toast" vertex="1">
          <mxGeometry height="110" width="240" x="1220" y="740" as="geometry" />
        </mxCell>
        <mxCell id="flow-1-to-2" edge="1" parent="1" source="flow-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" target="flow-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-2-to-3" edge="1" parent="1" source="flow-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" target="flow-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-3-to-4" edge="1" parent="1" source="flow-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" target="flow-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-4-to-5" edge="1" parent="1" source="flow-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" target="flow-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tech-details" parent="1" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;spacingTop=5;fontStyle=1" value="🔧 OPEN SOURCE STACK&lt;br&gt;&lt;br&gt;Transport:&lt;br&gt;• WebRTC Data Channel (P2P)&lt;br&gt;• QUIC (low latency)&lt;br&gt;• Raw UDP (NAT traversal)&lt;br&gt;&lt;br&gt;Discovery:&lt;br&gt;• Avahi/mDNS (LAN, Bonjour)&lt;br&gt;• Mainline DHT (WAN)&lt;br&gt;• coturn (self-hosted STUN)&lt;br&gt;&lt;br&gt;Protocols:&lt;br&gt;• Yjs CRDT (collaboration)&lt;br&gt;• rsync algorithm (delta)&lt;br&gt;• Syncthing BEP&lt;br&gt;&lt;br&gt;Security:&lt;br&gt;• Noise Protocol Framework&lt;br&gt;• Ed25519 keys&lt;br&gt;• ChaCha20-Poly1305&lt;br&gt;&lt;br&gt;Storage:&lt;br&gt;• SQLite (metadata)&lt;br&gt;• Local filesystem only" vertex="1">
          <mxGeometry height="320" width="240" x="100" y="900" as="geometry" />
        </mxCell>
        <mxCell id="sync-modes" parent="1" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;spacingTop=5;fontStyle=1" value="🔀 P2P SYNC MODES&lt;br&gt;&lt;br&gt;Mode 1: LAN Direct (mDNS)&lt;br&gt;✅ Fastest (1-10 Gbps)&lt;br&gt;✅ Zero config&lt;br&gt;✅ Works offline&lt;br&gt;✅ No internet needed&lt;br&gt;❌ Same network only&lt;br&gt;&lt;br&gt;Mode 2: WAN P2P (DHT)&lt;br&gt;✅ Works globally&lt;br&gt;✅ NAT hole punching&lt;br&gt;✅ BitTorrent-style DHT&lt;br&gt;✅ No central servers&lt;br&gt;❌ Slower (10-100 Mbps)&lt;br&gt;&lt;br&gt;Mode 3: Self-Hosted Relay&lt;br&gt;✅ Your own infrastructure&lt;br&gt;✅ Control &amp; privacy&lt;br&gt;✅ No third parties&lt;br&gt;❌ Requires VPS setup" vertex="1">
          <mxGeometry height="320" width="240" x="380" y="900" as="geometry" />
        </mxCell>
        <mxCell id="conflict-resolution" parent="1" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;spacingTop=5;fontStyle=1" value="⚠️ CONFLICT RESOLUTION&lt;br&gt;&lt;br&gt;OWL Triple Conflicts:&lt;br&gt;• Use CRDT (Conflict-free Replicated Data Type)&lt;br&gt;• Apply commutative operations&lt;br&gt;• Preserve triple order&lt;br&gt;&lt;br&gt;Binary File Conflicts:&lt;br&gt;• Keep both versions&lt;br&gt;• Notify user with diff UI&lt;br&gt;• Allow manual merge&lt;br&gt;&lt;br&gt;Resolution Strategies:&lt;br&gt;1. Last-Write-Wins (timestamp)&lt;br&gt;2. First-Write-Wins (version vector)&lt;br&gt;3. Manual merge (user choice)&lt;br&gt;4. Semantic merge (OWL reasoner)&lt;br&gt;&lt;br&gt;Conflict UI:&lt;br&gt;• Side-by-side diff viewer&lt;br&gt;• Triple-level granularity&lt;br&gt;• Accept left/right/both buttons&lt;br&gt;• Test resolution with reasoner" vertex="1">
          <mxGeometry height="320" width="240" x="660" y="900" as="geometry" />
        </mxCell>
        <mxCell id="performance-notes" parent="1" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;spacingTop=5;fontStyle=1" value="⚡ PERFORMANCE OPTIMIZATIONS&lt;br&gt;&lt;br&gt;Delta Sync:&lt;br&gt;• Only send changed blocks (4KB chunks)&lt;br&gt;• Rolling hash for deduplication&lt;br&gt;• Compression ratio: ~90% for text&lt;br&gt;&lt;br&gt;Bandwidth Efficiency:&lt;br&gt;• Adaptive rate limiting&lt;br&gt;• Batch small changes&lt;br&gt;• Priority queue for urgent files&lt;br&gt;&lt;br&gt;Storage Efficiency:&lt;br&gt;• Content-addressable storage (CAS)&lt;br&gt;• Deduplication across versions&lt;br&gt;• Garbage collection for old versions&lt;br&gt;&lt;br&gt;Sync Performance:&lt;br&gt;• LAN: &lt;1s for 10MB file&lt;br&gt;• WAN: 2-5s for 10MB file&lt;br&gt;• Delta: &lt;100ms for 100KB changes&lt;br&gt;&lt;br&gt;Scalability:&lt;br&gt;• Supports 100+ devices per workspace&lt;br&gt;• Mesh topology for large teams&lt;br&gt;• Automatic peer pruning" vertex="1">
          <mxGeometry height="320" width="280" x="940" y="900" as="geometry" />
        </mxCell>
        <mxCell id="security-notes" parent="1" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;spacingTop=5;fontStyle=1" value="🔒 PRIVACY &amp; SECURITY&lt;br&gt;&lt;br&gt;Encryption:&lt;br&gt;• E2EE with Noise Protocol&lt;br&gt;• ChaCha20-Poly1305&lt;br&gt;• AES-256-GCM (at rest)&lt;br&gt;• Perfect forward secrecy&lt;br&gt;&lt;br&gt;Authentication:&lt;br&gt;• Ed25519 keypairs&lt;br&gt;• Device fingerprints&lt;br&gt;• QR code pairing&lt;br&gt;• No passwords&lt;br&gt;&lt;br&gt;Authorization:&lt;br&gt;• Local trust database&lt;br&gt;• Peer approval required&lt;br&gt;• Manual device pairing&lt;br&gt;• Revocation lists&lt;br&gt;&lt;br&gt;Privacy:&lt;br&gt;• 100% local storage&lt;br&gt;• No telemetry/tracking&lt;br&gt;• Tor/I2P compatible&lt;br&gt;• GDPR compliant" vertex="1">
          <mxGeometry height="320" width="240" x="1260" y="900" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
