# Plugin Initialization Service
# Inserts default plugins into MongoDB using Node.js script
FROM node:21-alpine

WORKDIR /app

# Install bash and curl for health checks
RUN apk add --no-cache bash curl

# Copy package.json and install dependencies first (for better caching)
COPY scripts/package.json ./package.json
RUN npm install mongodb

# Copy the insert plugins script
COPY scripts/insert-default-plugins.js ./insert-default-plugins.js

# Wait for MongoDB to be ready, then insert plugins and exit
CMD ["sh", "-c", "echo 'Waiting for MongoDB to be ready...' && sleep 10 && node insert-default-plugins.js && echo 'Plugin initialization complete!'"]
