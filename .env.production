# OntoCode Environment Variables
# Copy this file to .env and customize for your environment

# ========== DATABASE CONFIGURATION ==========
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme123
MONGODB_URI='mongodb://localhost:27017'
MONGODB_DATABASE=ontology

# ========== SECURITY CONFIGURATION ==========
# IMPORTANT: Change this to a secure random string (min 256 bits)
JWT_SECRET=***REMOVED-JWT-SECRET***

# ========== GRAPHDB CONFIGURATION ==========
GRAPHDB_REPOSITORY=ontocode

# ========== APPLICATION CONFIGURATION ==========
SPRING_PROFILES_ACTIVE=production
BASE_URL=http://localhost:8082
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:3001

# ========== EMAIL CONFIGURATION ==========
# Mailtrap (for Auth Service)
MAILTRAP_API_TOKEN=***REMOVED-MAILTRAP-TOKEN***
EMAIL_FROM=noreply@ontocode.com

# Gmail (for Editor Service - notifications)
GMAIL_USERNAME=sindhuja@coretopia.com
GMAIL_APP_PASSWORD=***REMOVED-GMAIL-APP-PASSWORD***
EMAIL_ENABLED=true

# ========== LOGGING CONFIGURATION ==========
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SELF_RESEARCH=DEBUG

# ========== ADMIN TOOLS ==========
# MongoDB Express credentials
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=pass

GDB_LICENSE_FILE=CORETOPIA_GRAPHDB_FREE_v11.1.license
GDB_LICENSE_PATH=.