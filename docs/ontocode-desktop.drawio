          <mxGeometry x="80" y="370" width="340" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="da-syncthing" value="🔄 Syncthing daemon (:18384)&#xa;• Watches workspace folder&#xa;• Encrypts + sends delta blocks&#xa;• Verifies peer device ID" style="rounded=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="430" width="340" height="80" as="geometry"/>
        </mxCell>
