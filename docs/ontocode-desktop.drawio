        </mxCell>
        <mxCell id="da-lic" value="🔑 license.json (FREE plan — sync included)" style="rounded=1;fillColor=#fce8e6;strokeColor=#ea4335;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="574" width="340" height="36" as="geometry"/>
        </mxCell>

        <!-- Middle — P2P Channel -->
        <mxCell id="mid-bg" value="" style="rounded=1;fillColor=#f9f9f9;strokeColor=#34a853;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="110" width="300" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="mid-title" value="P2P Transport Layer" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=13;fontStyle=1;fontColor=#34a853;" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="300" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="mid-direct" value="🔗 Direct connection (same LAN)&#xa;Syncthing auto-discovers via mDNS" style="rounded=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="496" y="160" width="268" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mid-relay" value="🌐 Relay server (different network)&#xa;Open-source Syncthing relay&#xa;(data encrypted — relay sees nothing)" style="rounded=1;fillColor=#fff3cd;strokeColor=#d6ae00;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="496" y="240" width="268" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="mid-sec" value="🔒 Security&#xa;• TLS 1.3 encrypted in transit&#xa;• Content-addressed blocks&#xa;• Device ID = certificate hash&#xa;• No man-in-the-middle possible" style="rounded=1;fillColor=#fce8e6;strokeColor=#ea4335;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="330" width="268" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="mid-proto" value="Protocol: Syncthing BEP&#xa;(Block Exchange Protocol)&#xa;• Delta sync — sends only changed blocks&#xa;• Works offline — queues until peer online" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="496" y="450" width="268" height="80" as="geometry"/>
