        </mxCell>
        <mxCell id="cmp-cloud" value="⭐  Cloud Sync (PRO) — async relay, devices can be offline, change history, conflict resolution UI" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="108" width="560" height="24" as="geometry"/>
        </mxCell>

        <!-- Bootstrap step -->
        <mxCell id="boot-title" value="Step 1 — Initial Bootstrap  (first time Desktop B gets the workspace)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#0097a7;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="1200" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="boot-note" value="Identity = Cloud account login (email/JWT), NOT the license file.  License file = Pro entitlement proof only.  Sync is user-driven — user must click 'Enable Cloud Sync' explicitly." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontStyle=2;fontColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="60" y="208" width="1200" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="boot-da-bg" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="310" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="boot-da-title" value="🖥  Desktop A  (workspace owner)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="248" width="310" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="boot-da-1" value="1. Sign in to OntoCode Cloud&#xa;   (email + password → JWT stored)" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="278" width="278" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="boot-da-2" value="2. Click 'Enable Cloud Sync' on workspace&#xa;   (user-driven — not automatic)" style="rounded=1;fillColor=#fff3cd;strokeColor=#d6ae00;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="76" y="326" width="278" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="boot-da-3" value="3. Full .owl + sidecars uploaded&#xa;   to cloud (GridFS snapshot)" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="374" width="278" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="boot-cloud-bg" value="" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="240" width="360" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="boot-cloud-title" value="☁  OntoCode Cloud  (async relay)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="450" y="248" width="360" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="boot-cloud-1" value="4. Stores full .owl snapshot in GridFS&#xa;   Writes WorkspaceSync metadata" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="466" y="278" width="328" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="boot-cloud-2" value="5. User with same account OR shared email&#xa;   sees workspace in 'Available Workspaces'&#xa;   (owner shares by email — like Google Drive)" style="rounded=1;fillColor=#fff3e0;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="466" y="326" width="328" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="boot-cloud-3" value="Collections: OntologyChange · DeviceSyncState · MergeConflict" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="466" y="390" width="328" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="boot-db-bg" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="890" y="240" width="370" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="boot-db-title" value="🖥  Desktop B  (same/shared account)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="890" y="248" width="370" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="boot-db-1" value="6. Sign in with same/invited account&#xa;   → sees shared workspaces list" style="rounded=1;fillColor=#e6f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="906" y="278" width="338" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="boot-db-2" value="7. Click 'Download Workspace' (one click)" style="rounded=1;fillColor=#fff3cd;strokeColor=#d6ae00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="906" y="326" width="338" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="boot-db-3" value="8. Gets full .owl snapshot from GridFS&#xa;   Creates local workspace · Records DeviceSyncState T0" style="rounded=1;fillColor=#e6f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="906" y="370" width="338" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="boot-arr-a" value="POST snapshot" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="boot-da-bg" target="boot-cloud-bg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="boot-arr-b" value="GET snapshot" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;fontColor=#82b366;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="boot-cloud-bg" target="boot-db-bg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Incremental sync -->
        <mxCell id="inc-title" value="Step 2 — Incremental Sync  (ongoing, async — devices do NOT need to be online simultaneously)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="468" width="1200" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="inc-da-bg" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="508" width="310" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="inc-da-title" value="🖥  Desktop A  (edits ontology)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="516" width="310" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="inc-da-1" value="1. User makes edits (classes, properties…)" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="546" width="278" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="inc-da-2" value="2. Each edit → local DraftChange (syncedToServer=false)" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="586" width="278" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="inc-da-3" value="3. Background worker OR 'Sync Now'&#xa;   POST /api/ontology/changes/sync" style="rounded=1;fillColor=#fff3cd;strokeColor=#d6ae00;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="76" y="634" width="278" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="inc-da-4" value="4. DraftChange.syncedToServer = true" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="76" y="682" width="278" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="inc-cloud-bg" value="" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="508" width="360" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="inc-cloud-title" value="☁  OntoCode Cloud  (change log)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="450" y="516" width="360" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="inc-cloud-1" value="5. Validates JWT · Applies to Fuseki&#xa;   Writes canonical OntologyChange row to MongoDB" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="466" y="546" width="328" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="inc-cloud-2" value="6. Updates DeviceSyncState cursor for Device A" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="466" y="602" width="328" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="inc-cloud-3" value="✅ Device B can retrieve changes HOURS or DAYS later" style="rounded=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="466" y="642" width="328" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="inc-cloud-4" value="Conflict queue: MergeConflict collection" style="rounded=1;fillColor=#fce8e6;strokeColor=#ea4335;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="466" y="686" width="328" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="inc-db-bg" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="890" y="508" width="370" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="inc-db-title" value="🖥  Desktop B  (receives changes later)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="890" y="516" width="370" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="inc-db-1" value="7. Comes online (hours or days later)&#xa;   On launch OR 'Sync Now' tap" style="rounded=1;fillColor=#e6f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="906" y="546" width="338" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="inc-db-2" value="8. GET /api/ontology/changes?since=T0&#xa;   (T0 = last DeviceSyncState cursor)" style="rounded=1;fillColor=#fff3cd;strokeColor=#d6ae00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="906" y="594" width="338" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="inc-db-3" value="9. Replays missing OntologyChange events&#xa;   into local Fuseki TDB2 cache" style="rounded=1;fillColor=#e6f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="906" y="642" width="338" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="inc-db-4" value="10. Updates local DeviceSyncState cursor to T_now" style="rounded=1;fillColor=#e6f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="906" y="690" width="338" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="inc-arr-a" value="POST changes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inc-da-bg" target="inc-cloud-bg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="inc-arr-b" value="GET changes since T0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;fontColor=#82b366;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inc-cloud-bg" target="inc-db-bg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Sync choice banner -->
        <mxCell id="choice-bg" value="" style="rounded=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="738" width="1200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="choice-title" value="Which Sync to Use?" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="60" y="746" width="1200" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="choice-p2p" value="✅  P2P Sync (Syncthing) — FREE&#xa;Both devices must be on same LAN or internet&#xa;at the same time (or Syncthing relay queues it)" style="rounded=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="774" width="540" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="choice-cloud" value="⭐  Cloud Sync (OntoCode Cloud) — PRO&#xa;Devices can be completely offline for days&#xa;Change history · Conflict resolution · Team sharing" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="700" y="774" width="540" height="50" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ═══════════════════════════════════════════════════════════
       PAGE 5 — Cloud vs Desktop Boundary
       ═══════════════════════════════════════════════════════════ -->
  <diagram id="boundary" name="Cloud vs Desktop">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="b-title" value="OntoCode — Cloud vs Desktop Feature Boundary" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1200" height="40" as="geometry"/>
        </mxCell>

        <!-- DESKTOP -->
        <mxCell id="d-bg" value="" style="rounded=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=3;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="500" height="800" as="geometry"/>
        </mxCell>
        <mxCell id="d-title" value="🖥  OntoCode Desktop" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=16;fontStyle=1;fontColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="60" y="92" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d-sub" value="Offline · File-based · No account required for core features" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="500" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="d-f1" value="✅ Open / Save .owl .ttl .rdf files" style="rounded=1;fillColor=#fff;strokeColor=#1a73e8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="156" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f2" value="✅ Full ontology editing (classes, properties, individuals)" style="rounded=1;fillColor=#fff;strokeColor=#1a73e8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="198" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f3" value="✅ HermiT + Openllet reasoning (free)" style="rounded=1;fillColor=#fff;strokeColor=#1a73e8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f4" value="✅ SPARQL queries + SWRL rules" style="rounded=1;fillColor=#fff;strokeColor=#1a73e8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="282" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f5" value="✅ Plugin system (SPARQL / SWRL / Fuzzy + marketplace)" style="rounded=1;fillColor=#fff;strokeColor=#1a73e8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="324" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f6" value="✅ Works fully offline — no internet required" style="rounded=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="366" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f7" value="✅ P2P sync via Syncthing — FREE, no cloud needed" style="rounded=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="408" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f8" value="✅ Local account — no cloud account required" style="rounded=1;fillColor=#fff;strokeColor=#1a73e8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="450" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f9" value="⭐ ELK + Pellet reasoning (Pro license)" style="rounded=1;fillColor=#fce8e6;strokeColor=#ea4335;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="492" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f10" value="⭐ Cloud sync — async relay for offline teams (Pro + Cloud account)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="80" y="534" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f11" value="❌ No real-time collaboration" style="rounded=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;fontColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="80" y="576" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="d-f12" value="❌ No hosted SPARQL endpoint" style="rounded=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;fontColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="80" y="618" width="460" height="34" as="geometry"/></mxCell>

        <!-- CLOUD -->
        <mxCell id="c-bg" value="" style="rounded=1;fillColor=#e6f4ea;strokeColor=#34a853;strokeWidth=3;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="790" y="80" width="500" height="800" as="geometry"/>
        </mxCell>
        <mxCell id="c-title" value="☁  OntoCode Cloud" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=16;fontStyle=1;fontColor=#34a853;" vertex="1" parent="1">
          <mxGeometry x="790" y="92" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c-sub" value="Collaborative · Web + API · Account required" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="790" y="120" width="500" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="c-f1" value="✅ Everything the Desktop does (plus below)" style="rounded=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="156" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="c-f2" value="✅ Real-time multi-user collaborative editing" style="rounded=1;fillColor=#fff;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="198" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="c-f3" value="✅ Live presence (see who is editing)" style="rounded=1;fillColor=#fff;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="240" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="c-f4" value="✅ Persistent hosted SPARQL endpoint (Fuseki)" style="rounded=1;fillColor=#fff;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="282" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="c-f5" value="✅ Full change history + audit log" style="rounded=1;fillColor=#fff;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="324" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="c-f6" value="✅ Role-based access (admin / editor / viewer)" style="rounded=1;fillColor=#fff;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="366" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="c-f7" value="✅ Workspace + project management (multi-team)" style="rounded=1;fillColor=#fff;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="408" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="c-f8" value="✅ Cloud-hosted plugins and marketplace" style="rounded=1;fillColor=#fff;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="450" width="460" height="34" as="geometry"/></mxCell>
        <mxCell id="c-f9" value="✅ Subscription billing (Stripe)" style="rounded=1;fillColor=#fff;strokeColor=#34a853;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="492" width="460" height="34" as="geometry"/></mxCell>
