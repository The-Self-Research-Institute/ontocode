  <!-- ═══════════════════════════════════════════════════════════
       PAGE 2 — Decentralized P2P Sync (Syncthing)
       ═══════════════════════════════════════════════════════════ -->
  <diagram id="p2p-sync" name="Decentralized P2P Sync">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="s-title" value="OntoCode Desktop — Decentralized P2P Sync (Syncthing, No Cloud)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1;fontColor=#34a853;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s-sub" value="✅ Works offline  •  ✅ No server required  •  ✅ FREE for all plans  •  ✅ Direct device-to-device  •  Optional Syncthing relay for NAT traversal (open source)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontColor=#34a853;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="60" width="1200" height="24" as="geometry"/>
        </mxCell>

        <!-- Desktop A -->
        <mxCell id="da-bg" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="380" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="da-title" value="🖥️  Desktop A  (workspace owner)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="380" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="da-app" value="OntoCode App&#xa;(Electron + Spring Boot)" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="340" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="da-s1" value="1️⃣  Click 'Enable Sync' on workspace" style="rounded=1;fillColor=#fff3cd;strokeColor=#d6ae00;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="224" width="340" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="da-s2" value="2️⃣  SyncManager.shareFolder(path, label)" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="268" width="340" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="da-s3" value="3️⃣  syncGenerateLink([folderId])&#xa;      → ontocode-sync://base64{deviceId,folders}" style="rounded=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="312" width="340" height="44" as="geometry"/>
        </mxCell>
