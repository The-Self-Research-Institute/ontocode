Prefix(:=<http://example.org/rc#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(swrlb:=<http://www.w3.org/2003/11/swrlb#>)
Ontology(<http://example.org/rc>
Declaration(DataProperty(:hasAge))
Declaration(DataProperty(:nextAge))
Declaration(NamedIndividual(:a))
DataPropertyAssertion(:hasAge :a "30"^^xsd:integer)
DLSafeRule(Body(DataPropertyAtom(:hasAge Variable(:x) Variable(:v)) BuiltInAtom(swrlb:add Variable(:w) Variable(:v) "1"^^xsd:integer)) Head(DataPropertyAtom(:nextAge Variable(:x) Variable(:w))))
)
