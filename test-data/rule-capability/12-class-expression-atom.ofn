Prefix(:=<http://example.org/rc#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(swrlb:=<http://www.w3.org/2003/11/swrlb#>)
Ontology(<http://example.org/rc>
Declaration(Class(:Person))
Declaration(Class(:Parent))
Declaration(ObjectProperty(:hasChild))
Declaration(NamedIndividual(:a))
Declaration(NamedIndividual(:b))
ObjectPropertyAssertion(:hasChild :a :b)
ClassAssertion(:Person :b)
DLSafeRule(Body(ClassAtom(ObjectSomeValuesFrom(:hasChild :Person) Variable(:x))) Head(ClassAtom(:Parent Variable(:x))))
)
