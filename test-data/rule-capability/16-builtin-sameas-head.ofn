Prefix(:=<http://example.org/rc#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(swrlb:=<http://www.w3.org/2003/11/swrlb#>)
Ontology(<http://example.org/rc>
Declaration(Class(:K))
Declaration(DataProperty(:hasAge))
Declaration(NamedIndividual(:a))
Declaration(NamedIndividual(:k))
DataPropertyAssertion(:hasAge :a "30"^^xsd:integer)
DLSafeRule(Body(DataPropertyAtom(:hasAge Variable(:x) Variable(:v)) BuiltInAtom(swrlb:add Variable(:w) Variable(:v) "1"^^xsd:integer) BuiltInAtom(swrlb:greaterThan Variable(:w) "18"^^xsd:integer)) Head(SameIndividualAtom(Variable(:x) :k)))
)
