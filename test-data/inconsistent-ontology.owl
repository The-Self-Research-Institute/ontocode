<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/inconsistent#"
     xml:base="http://www.example.org/inconsistent"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
    
    <owl:Ontology rdf:about="http://www.example.org/inconsistent">
        <rdfs:label>Inconsistent Test Ontology</rdfs:label>
        <rdfs:comment>A deliberately inconsistent OWL ontology for Reasoner Plugin testing. Contains contradictions: an individual belongs to two disjoint classes, and an unsatisfiable class.</rdfs:comment>
    </owl:Ontology>

    <!-- ======================== -->
    <!-- CLASSES                  -->
    <!-- ======================== -->

    <owl:Class rdf:about="http://www.example.org/inconsistent#Animal">
        <rdfs:label>Animal</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.example.org/inconsistent#Plant">
        <rdfs:label>Plant</rdfs:label>
    </owl:Class>

    <!-- CONTRADICTION 1: Animal and Plant are declared disjoint -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="http://www.example.org/inconsistent#Animal"/>
            <owl:Class rdf:about="http://www.example.org/inconsistent#Plant"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:Class rdf:about="http://www.example.org/inconsistent#Dog">
        <rdfs:subClassOf rdf:resource="http://www.example.org/inconsistent#Animal"/>
        <rdfs:label>Dog</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.example.org/inconsistent#Cat">
        <rdfs:subClassOf rdf:resource="http://www.example.org/inconsistent#Animal"/>
        <rdfs:label>Cat</rdfs:label>
    </owl:Class>

    <!-- DISJOINT: Dog and Cat are disjoint -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="http://www.example.org/inconsistent#Dog"/>
            <owl:Class rdf:about="http://www.example.org/inconsistent#Cat"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- CONTRADICTION 2: Unsatisfiable class — subclass of both Dog and Cat (which are disjoint) -->
    <owl:Class rdf:about="http://www.example.org/inconsistent#DogCatHybrid">
        <rdfs:subClassOf rdf:resource="http://www.example.org/inconsistent#Dog"/>
        <rdfs:subClassOf rdf:resource="http://www.example.org/inconsistent#Cat"/>
        <rdfs:label>Dog-Cat Hybrid</rdfs:label>
        <rdfs:comment>This class is unsatisfiable because Dog and Cat are disjoint</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://www.example.org/inconsistent#Tree">
        <rdfs:subClassOf rdf:resource="http://www.example.org/inconsistent#Plant"/>
        <rdfs:label>Tree</rdfs:label>
    </owl:Class>

    <!-- ======================== -->
    <!-- PROPERTIES               -->
    <!-- ======================== -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/inconsistent#hasName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has name</rdfs:label>
    </owl:DatatypeProperty>

    <!-- ======================== -->
    <!-- INDIVIDUALS              -->
    <!-- ======================== -->

    <!-- CONTRADICTION 3: Creature1 declared as both Animal AND Plant (disjoint classes) -->
    <owl:NamedIndividual rdf:about="http://www.example.org/inconsistent#Creature1">
        <rdf:type rdf:resource="http://www.example.org/inconsistent#Animal"/>
        <rdf:type rdf:resource="http://www.example.org/inconsistent#Plant"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Impossible Creature</hasName>
        <rdfs:label>Creature 1</rdfs:label>
        <rdfs:comment>This individual causes inconsistency by being both Animal and Plant</rdfs:comment>
    </owl:NamedIndividual>

    <!-- Normal consistent individual for comparison -->
    <owl:NamedIndividual rdf:about="http://www.example.org/inconsistent#Rex">
        <rdf:type rdf:resource="http://www.example.org/inconsistent#Dog"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rex</hasName>
        <rdfs:label>Rex the Dog</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.example.org/inconsistent#OakTree">
        <rdf:type rdf:resource="http://www.example.org/inconsistent#Tree"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oak Tree</hasName>
        <rdfs:label>Oak Tree</rdfs:label>
    </owl:NamedIndividual>

</rdf:RDF>
