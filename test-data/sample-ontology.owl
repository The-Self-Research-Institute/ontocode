<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/sample#"
     xml:base="http://www.example.org/sample"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
    
    <owl:Ontology rdf:about="http://www.example.org/sample">
        <rdfs:label>Sample Ontology</rdfs:label>
        <rdfs:comment>Simple 5-class ontology for basic Graph View testing.</rdfs:comment>
    </owl:Ontology>

    <owl:Class rdf:about="http://www.example.org/sample#Shape">
        <rdfs:label>Shape</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.example.org/sample#Circle">
        <rdfs:subClassOf rdf:resource="http://www.example.org/sample#Shape"/>
        <rdfs:label>Circle</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.example.org/sample#Rectangle">
        <rdfs:subClassOf rdf:resource="http://www.example.org/sample#Shape"/>
        <rdfs:label>Rectangle</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.example.org/sample#Square">
        <rdfs:subClassOf rdf:resource="http://www.example.org/sample#Rectangle"/>
        <rdfs:label>Square</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.example.org/sample#Triangle">
        <rdfs:subClassOf rdf:resource="http://www.example.org/sample#Shape"/>
        <rdfs:label>Triangle</rdfs:label>
    </owl:Class>

    <owl:DatatypeProperty rdf:about="http://www.example.org/sample#hasArea">
        <rdfs:domain rdf:resource="http://www.example.org/sample#Shape"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>has area</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/sample#hasColor">
        <rdfs:domain rdf:resource="http://www.example.org/sample#Shape"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has color</rdfs:label>
    </owl:DatatypeProperty>

    <owl:NamedIndividual rdf:about="http://www.example.org/sample#RedCircle">
        <rdf:type rdf:resource="http://www.example.org/sample#Circle"/>
        <hasArea rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">78.54</hasArea>
        <hasColor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Red</hasColor>
        <rdfs:label>Red Circle</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://www.example.org/sample#BlueSquare">
        <rdf:type rdf:resource="http://www.example.org/sample#Square"/>
        <hasArea rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</hasArea>
        <hasColor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Blue</hasColor>
        <rdfs:label>Blue Square</rdfs:label>
    </owl:NamedIndividual>

</rdf:RDF>
