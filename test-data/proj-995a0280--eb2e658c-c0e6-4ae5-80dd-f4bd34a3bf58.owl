<rdf:Description rdf:about="http://example.org/target-ontology#test">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:label>test</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/target-ontology#testingindividualsmini">
	<rdf:type rdf:resource="http://example.org/ontology#MiniPony"/>
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdfs:label>testingindividualsmini</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/target-ontology#testingindividual">
	<rdf:type rdf:resource="http://example.org/ontology#MiniPony"/>
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdfs:label>testingindividual</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/target-ontology#testing_the_property">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
	<rdfs:label>testing the property</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/target-ontology">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
	<dc:description>Baseline target ontology containing entities that conflict with the source ontology.</dc:description>
	<dc:title>Target Ontology for Merge Testing</dc:title>
	<owl:versionInfo>1.0.0</owl:versionInfo>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#usa">
	<rdf:type rdf:resource="http://example.org/ontology#Country"/>
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdfs:label>United States</rdfs:label>
	<ex:hasName>United States of America</ex:hasName>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#rex">
	<rdf:type rdf:resource="http://example.org/ontology#Dog"/>
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdfs:comment>TARGET only: Rex the dog (should be removed by Replace Duplicates)</rdfs:comment>
	<rdfs:label>Rex</rdfs:label>
	<ex:hasName>Rex</ex:hasName>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#carol">
	<rdf:type rdf:resource="http://example.org/ontology#Manager"/>
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdfs:comment>TARGET only: Carol is a manager</rdfs:comment>
	<rdfs:label>Carol Davis</rdfs:label>
	<ex:hasName>Carol Davis</ex:hasName>
	<ex:manages rdf:resource="http://example.org/ontology#john"/>
	<ex:worksAt rdf:resource="http://example.org/ontology#acmeCorp"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#john">
	<rdf:type rdf:resource="http://example.org/ontology#Employee"/>
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdfs:comment>TARGET: John is an employee</rdfs:comment>
	<rdfs:label>John Smith</rdfs:label>
	<ex:hasAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</ex:hasAge>
	<ex:hasEmail>john.smith@company.com</ex:hasEmail>
	<ex:hasName>John Smith</ex:hasName>
	<ex:worksAt rdf:resource="http://example.org/ontology#acmeCorp"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#bob">
	<rdf:type rdf:resource="http://example.org/ontology#Person"/>
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdfs:comment>TARGET: Bob knows John</rdfs:comment>
	<rdfs:label>Bob Williams</rdfs:label>
	<ex:hasName>Bob Williams</ex:hasName>
	<ex:knows rdf:resource="http://example.org/ontology#john"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#alice">
	<rdf:type rdf:resource="http://example.org/ontology#Person"/>
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdfs:comment>TARGET: Alice is 28 years old</rdfs:comment>
	<rdfs:label>Alice Johnson</rdfs:label>
	<ex:hasAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</ex:hasAge>
	<ex:hasEmail>alice@oldmail.com</ex:hasEmail>
	<ex:hasName>Alice Johnson</ex:hasName>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#acmeCorp">
	<rdf:type rdf:resource="http://example.org/ontology#Company"/>
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdfs:label>Acme Corp</rdfs:label>
	<ex:hasName>Acme Corporation</ex:hasName>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Vehicle">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>TARGET: A vehicle for transportation</rdfs:comment>
	<rdfs:label>Vehicle</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Student">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>TARGET: A person who studies</rdfs:comment>
	<rdfs:label>Student</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://example.org/ontology#Person"/>
	<rdfs:subClassOf rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db17"/>
</rdf:Description>

<rdf:Description rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db17">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
	<owl:onProperty rdf:resource="http://example.org/ontology#hasAge"/>
	<owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Pony">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>TARGET only: A small horse (not in source)</rdfs:comment>
	<rdfs:label>Pony</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://example.org/ontology#Horse"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#MiniPony">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>TARGET only: A miniature pony (not in source, deep hierarchy)</rdfs:comment>
	<rdfs:label>Mini Pony</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://example.org/ontology#Pony"/>
	<owl:disjointUnionOf rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db18"/>
</rdf:Description>

<rdf:Description rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db18">
	<rdf:first rdf:resource="http://example.org/ontology#Vehicle"/>
	<rdf:rest rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db19"/>
</rdf:Description>

<rdf:Description rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db19">
	<rdf:first rdf:resource="http://example.org/ontology#Horse"/>
	<rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#MiniPony">
	<owl:disjointWith rdf:resource="http://example.org/ontology#GuideDog"/>
	<owl:equivalentClass rdf:resource="http://example.org/ontology#MiniPony"/>
	<owl:hasKey rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db20"/>
</rdf:Description>

<rdf:Description rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db20">
	<rdf:first rdf:resource="http://example.org/ontology#knows"/>
	<rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#GuideDog">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>TARGET only: A service dog (child of shared Dog class)</rdfs:comment>
	<rdfs:label>Guide dog</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://example.org/ontology#Dog"/>
	<owl:equivalentClass rdf:resource="http://example.org/ontology#MiniPony"/>
	<owl:equivalentClass rdf:resource="http://example.org/ontology#GuideDog"/>
	<owl:equivalentClass rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db21"/>
</rdf:Description>

<rdf:Description rdf:nodeID="genid-start-34fe603a5b30248b1863f60e4701133db21">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
	<owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
	<owl:onClass rdf:resource="http://example.org/ontology#GuideDog"/>
	<owl:onProperty rdf:resource="http://example.org/ontology#livesIn"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Horse">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>TARGET only: Domestic horse (not in source)</rdfs:comment>
	<rdfs:label>Horse</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://example.org/ontology#Animal"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Dog">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>TARGET: Domestic dog</rdfs:comment>
	<rdfs:label>Dog</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://example.org/ontology#Animal"/>
	<owl:disjointWith rdf:resource="http://example.org/ontology#Horse"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#hasSalary">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:comment>Annual salary in USD (target only)</rdfs:comment>
	<rdfs:domain rdf:resource="http://example.org/ontology#Employee"/>
	<rdfs:label>has Salary</rdfs:label>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#hasName">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:comment>TARGET: Name of any animal</rdfs:comment>
	<rdfs:domain rdf:resource="http://example.org/ontology#Animal"/>
	<rdfs:label>has Name</rdfs:label>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#hasID">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:comment>Unique identifier</rdfs:comment>
	<rdfs:label>has ID</rdfs:label>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#hasEmail">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:comment>TARGET: Email address (not functional - multiple allowed)</rdfs:comment>
	<rdfs:domain rdf:resource="http://example.org/ontology#Person"/>
	<rdfs:label>has Email</rdfs:label>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#hasAge">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	<rdfs:comment>TARGET: Age as an integer</rdfs:comment>
	<rdfs:domain rdf:resource="http://example.org/ontology#Person"/>
	<rdfs:label>has Age</rdfs:label>
	<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Company">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>A business organization (target only)</rdfs:comment>
	<rdfs:label>Company</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#worksAt">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:comment>Relates an employee to their company (target only)</rdfs:comment>
	<rdfs:domain rdf:resource="http://example.org/ontology#Employee"/>
	<rdfs:label>works At</rdfs:label>
	<rdfs:range rdf:resource="http://example.org/ontology#Company"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Employee">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>A person employed by an organization (target only)</rdfs:comment>
	<rdfs:label>Employee</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://example.org/ontology#Person"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Manager">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>An employee who manages others (target only)</rdfs:comment>
	<rdfs:label>Manager</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://example.org/ontology#Employee"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#manages">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:comment>Relates a manager to employees they manage (target only)</rdfs:comment>
	<rdfs:domain rdf:resource="http://example.org/ontology#Manager"/>
	<rdfs:label>manages</rdfs:label>
	<rdfs:range rdf:resource="http://example.org/ontology#Employee"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Country">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>A sovereign nation</rdfs:comment>
	<rdfs:label>Country</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#livesIn">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:comment>Relates an entity to the country it lives in</rdfs:comment>
	<rdfs:label>lives In</rdfs:label>
	<rdfs:range rdf:resource="http://example.org/ontology#Country"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#knows">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:comment>TARGET: A directional social relationship (not symmetric)</rdfs:comment>
	<rdfs:domain rdf:resource="http://example.org/ontology#Person"/>
	<rdfs:label>knows</rdfs:label>
	<rdfs:range rdf:resource="http://example.org/ontology#Person"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Person">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>TARGET: Person is a subclass of Animal, no equivalence</rdfs:comment>
	<rdfs:label>Person</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://example.org/ontology#Animal"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#Animal">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<rdfs:comment>TARGET: Animal is a direct subclass of Thing</rdfs:comment>
	<rdfs:label>Animal</rdfs:label>
	<rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
	<ex:reviewStatus>Draft</ex:reviewStatus>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#hasParent">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:comment>TARGET: Relates any animal to its parent</rdfs:comment>
	<rdfs:domain rdf:resource="http://example.org/ontology#Animal"/>
	<rdfs:label>has Parent</rdfs:label>
	<rdfs:range rdf:resource="http://example.org/ontology#Animal"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#hasRelative">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:comment>TARGET: Relates a person to a relative (different hierarchy)</rdfs:comment>
	<rdfs:domain rdf:resource="http://example.org/ontology#Person"/>
	<rdfs:label>has Relative</rdfs:label>
	<rdfs:range rdf:resource="http://example.org/ontology#Person"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#hasCousin">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:comment>TARGET only: Cousin relationship</rdfs:comment>
	<rdfs:label>has Cousin</rdfs:label>
	<rdfs:subPropertyOf rdf:resource="http://example.org/ontology#hasRelative"/>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/ontology#targetTag">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
	<rdfs:comment>An annotation only present in the target ontology</rdfs:comment>
	<rdfs:label>Target Tag</rdfs:label>
</rdf:Description>

