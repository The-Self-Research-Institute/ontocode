<?xml version="1.0"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY co  "http://example.org/company#" >
]>
<rdf:RDF
     xmlns="http://example.org/company#"
     xml:base="http://example.org/company"
     xmlns:co="http://example.org/company#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">

    <owl:Ontology rdf:about="http://example.org/company"/>

    <!-- ═══════════════════════════════════
         CLASSES
         ═══════════════════════════════════ -->

    <owl:Class rdf:about="http://example.org/company#Person"/>

    <owl:Class rdf:about="http://example.org/company#Employee">
        <rdfs:subClassOf rdf:resource="http://example.org/company#Person"/>
    </owl:Class>

    <!-- Inferred by SWRL rule 1 — not declared as subclass of Employee
         so no OWL reasoner can pre-populate it -->
    <owl:Class rdf:about="http://example.org/company#SeniorEmployee"/>

    <!-- Inferred by SWRL rule 2 -->
    <owl:Class rdf:about="http://example.org/company#HighEarner"/>

    <!-- Inferred by SWRL rule 3 -->
    <owl:Class rdf:about="http://example.org/company#JuniorEmployee"/>

    <owl:Class rdf:about="http://example.org/company#Department"/>

    <!-- ═══════════════════════════════════
         OBJECT PROPERTIES
         ═══════════════════════════════════ -->

    <owl:ObjectProperty rdf:about="http://example.org/company#worksIn">
        <rdfs:domain rdf:resource="http://example.org/company#Employee"/>
        <rdfs:range  rdf:resource="http://example.org/company#Department"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/company#hasColleague">
        <rdfs:domain rdf:resource="http://example.org/company#Employee"/>
        <rdfs:range  rdf:resource="http://example.org/company#Employee"/>
        <rdf:type    rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </owl:ObjectProperty>

    <!-- ═══════════════════════════════════
         DATA PROPERTIES  (all ranges typed)
         ═══════════════════════════════════ -->

    <owl:DatatypeProperty rdf:about="http://example.org/company#hasAge">
        <rdfs:domain rdf:resource="http://example.org/company#Person"/>
        <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/company#hasName">
        <rdfs:domain rdf:resource="http://example.org/company#Person"/>
        <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/company#hasSalary">
        <rdfs:domain rdf:resource="http://example.org/company#Employee"/>
        <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/company#hasYearsExperience">
        <rdfs:domain rdf:resource="http://example.org/company#Employee"/>
        <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <!-- ═══════════════════════════════════
         DEPARTMENT INDIVIDUALS
         ═══════════════════════════════════ -->

    <owl:NamedIndividual rdf:about="http://example.org/company#IT">
        <rdf:type rdf:resource="http://example.org/company#Department"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/company#HR">
        <rdf:type rdf:resource="http://example.org/company#Department"/>
    </owl:NamedIndividual>

    <!-- ═══════════════════════════════════
         EMPLOYEE INDIVIDUALS
         ═══════════════════════════════════ -->

    <!-- john: age 35, salary 75000, exp 8 yrs → IT dept
         Expected SWRL output: SeniorEmployee (age>30), HighEarner (salary>70000) -->
    <owl:NamedIndividual rdf:about="http://example.org/company#john">
        <rdf:type rdf:resource="http://example.org/company#Employee"/>
        <hasAge              rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</hasAge>
        <hasName             rdf:datatype="http://www.w3.org/2001/XMLSchema#string">John Smith</hasName>
        <hasSalary           rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">75000.00</hasSalary>
        <hasYearsExperience  rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</hasYearsExperience>
        <worksIn rdf:resource="http://example.org/company#IT"/>
    </owl:NamedIndividual>

    <!-- alice: age 24, salary 45000, exp 2 yrs → IT dept
         Expected SWRL output: JuniorEmployee (exp<3) -->
    <owl:NamedIndividual rdf:about="http://example.org/company#alice">
        <rdf:type rdf:resource="http://example.org/company#Employee"/>
        <hasAge              rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</hasAge>
        <hasName             rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alice Johnson</hasName>
        <hasSalary           rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">45000.00</hasSalary>
        <hasYearsExperience  rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasYearsExperience>
        <worksIn rdf:resource="http://example.org/company#IT"/>
    </owl:NamedIndividual>

    <!-- bob: age 42, salary 92000, exp 15 yrs → HR dept
         Expected SWRL output: SeniorEmployee (age>30), HighEarner (salary>70000) -->
    <owl:NamedIndividual rdf:about="http://example.org/company#bob">
        <rdf:type rdf:resource="http://example.org/company#Employee"/>
        <hasAge              rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">42</hasAge>
        <hasName             rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bob Williams</hasName>
        <hasSalary           rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">92000.00</hasSalary>
        <hasYearsExperience  rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</hasYearsExperience>
        <worksIn rdf:resource="http://example.org/company#HR"/>
    </owl:NamedIndividual>

    <!-- carol: age 29, salary 62000, exp 4 yrs → HR dept
         Expected SWRL output: neither Senior (age<30) nor HighEarner (salary<70000) -->
    <owl:NamedIndividual rdf:about="http://example.org/company#carol">
        <rdf:type rdf:resource="http://example.org/company#Employee"/>
        <hasAge              rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29</hasAge>
        <hasName             rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carol Davis</hasName>
        <hasSalary           rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">62000.00</hasSalary>
        <hasYearsExperience  rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasYearsExperience>
        <worksIn rdf:resource="http://example.org/company#HR"/>
    </owl:NamedIndividual>

    <!-- david: age 38, salary 80000, exp 10 yrs → IT dept
         Expected SWRL output: SeniorEmployee (age>30), HighEarner (salary>70000) -->
    <owl:NamedIndividual rdf:about="http://example.org/company#david">
        <rdf:type rdf:resource="http://example.org/company#Employee"/>
        <hasAge              rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">38</hasAge>
        <hasName             rdf:datatype="http://www.w3.org/2001/XMLSchema#string">David Lee</hasName>
        <hasSalary           rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">80000.00</hasSalary>
        <hasYearsExperience  rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</hasYearsExperience>
        <worksIn rdf:resource="http://example.org/company#IT"/>
    </owl:NamedIndividual>

    <!-- AllDifferent: required so that differentFrom(?x,?y) works in SWRL Rule 4.
         swrlb:notEqual does NOT work for individuals (only literals) in SWRL4J/Drools. -->
    <owl:AllDifferent>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/company#john"/>
            <rdf:Description rdf:about="http://example.org/company#alice"/>
            <rdf:Description rdf:about="http://example.org/company#bob"/>
            <rdf:Description rdf:about="http://example.org/company#carol"/>
            <rdf:Description rdf:about="http://example.org/company#david"/>
            <rdf:Description rdf:about="http://example.org/company#IT"/>
            <rdf:Description rdf:about="http://example.org/company#HR"/>
        </owl:members>
    </owl:AllDifferent>

</rdf:RDF>
