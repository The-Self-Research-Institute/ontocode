<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/school#"
     xml:base="http://example.org/school"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://example.org/school"/>

    <owl:Class rdf:about="http://example.org/school#Student"/>
    <owl:Class rdf:about="http://example.org/school#HonorsStudent"/>

    <owl:DatatypeProperty rdf:about="http://example.org/school#hasGPA">
        <rdfs:domain rdf:resource="http://example.org/school#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:NamedIndividual rdf:about="http://example.org/school#Alice">
        <rdf:type rdf:resource="http://example.org/school#Student"/>
        <hasGPA rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.9</hasGPA>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/school#Bob">
        <rdf:type rdf:resource="http://example.org/school#Student"/>
        <hasGPA rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.2</hasGPA>
    </owl:NamedIndividual>

</rdf:RDF>