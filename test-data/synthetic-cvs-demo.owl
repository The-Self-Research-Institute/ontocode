<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/synthetic-cvs#"
     xml:base="https://example.org/synthetic-cvs"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:synthetic-cvs="https://example.org/synthetic-cvs#">
    <owl:Ontology rdf:about="https://example.org/synthetic-cvs">
        <rdfs:comment>Invented measurements and arbitrary test scores. There are no patient records and the rules make no clinical decisions.</rdfs:comment>
        <rdfs:label>Synthetic cardiovascular-measurement workflow for SWRL verification</rdfs:label>
    </owl:Ontology>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->





    <!-- https://example.org/synthetic-cvs#hasDataSource -->


    <owl:ObjectProperty rdf:about="https://example.org/synthetic-cvs#hasDataSource">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/synthetic-cvs#hasSession"/>
            <rdf:Description rdf:about="https://example.org/synthetic-cvs#usesDevice"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>



    <!-- https://example.org/synthetic-cvs#hasSession -->


    <owl:ObjectProperty rdf:about="https://example.org/synthetic-cvs#hasSession"/>



    <!-- https://example.org/synthetic-cvs#hasSite -->


    <owl:ObjectProperty rdf:about="https://example.org/synthetic-cvs#hasSite">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/synthetic-cvs#hasSession"/>
            <rdf:Description rdf:about="https://example.org/synthetic-cvs#occursAt"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>



    <!-- https://example.org/synthetic-cvs#hasUnit -->


    <owl:ObjectProperty rdf:about="https://example.org/synthetic-cvs#hasUnit"/>



    <!-- https://example.org/synthetic-cvs#hasVendor -->


    <owl:ObjectProperty rdf:about="https://example.org/synthetic-cvs#hasVendor">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/synthetic-cvs#hasDataSource"/>
            <rdf:Description rdf:about="https://example.org/synthetic-cvs#suppliedBy"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>



    <!-- https://example.org/synthetic-cvs#occursAt -->


    <owl:ObjectProperty rdf:about="https://example.org/synthetic-cvs#occursAt"/>



    <!-- https://example.org/synthetic-cvs#suppliedBy -->


    <owl:ObjectProperty rdf:about="https://example.org/synthetic-cvs#suppliedBy"/>



    <!-- https://example.org/synthetic-cvs#usesDevice -->


    <owl:ObjectProperty rdf:about="https://example.org/synthetic-cvs#usesDevice"/>



