# Build the standalone React (webview-src) app.
# Use Debian (glibc), not Alpine (musl): webview-src pins @rollup/rollup-linux-x64-gnu
# for WSL/EC2 hosts; musl would fail npm ci with EBADPLATFORM.
FROM --platform=linux/amd64 node:22-bookworm-slim AS builder

WORKDIR /app

# Extension manifest (app version for __APP_VERSION__) + webview package files
COPY ontology-vscode-extension/package.json ./extension-package.json
COPY ontology-vscode-extension/webview-src/package*.json ./

# Install dependencies
RUN npm config set fetch-retries 10 && \
    npm config set fetch-retry-mintimeout 10000 && \
    npm config set fetch-retry-maxtimeout 300000 && \
    npm config set fetch-timeout 300000 && \
    npm ci

# Copy webview source
COPY ontology-vscode-extension/webview-src ./
COPY plugins /plugins

# Build production bundle (reads .env.production for VITE_CLOUD_GATEWAY_URL)
RUN npm run build
RUN sed -n 's/^VITE_CLOUD_GATEWAY_URL=//p' .env.production | head -1 | tr -d '\r"' | sed -E 's#^(https?://[^/]+).*#\1#' > /api-origin.txt; test -f /api-origin.txt

# ── Runtime: nginx serving static files ──────────────────────────────────────
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html
COPY --from=builder /api-origin.txt /tmp/api-origin.txt

RUN echo 'add_header X-Content-Type-Options "nosniff" always; add_header Referrer-Policy "no-referrer" always; add_header X-Frame-Options "DENY" always; add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' https://js.stripe.com __API_ORIGIN__; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; img-src '"'"'self'"'"' data: blob: https:; font-src '"'"'self'"'"' data:; connect-src '"'"'self'"'"' https: wss: https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; object-src '"'"'none'"'"'; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'; frame-ancestors '"'"'none'"'"'" always;' > /etc/nginx/security-headers.conf
RUN sed -i "s#__API_ORIGIN__#$(cat /tmp/api-origin.txt)#" /etc/nginx/security-headers.conf

# nginx config for SPA routing
RUN echo 'server { \
    listen 3000; \
    listen [::]:3000; \
    root /usr/share/nginx/html; \
    index index.html; \
    include /etc/nginx/security-headers.conf; \
    location /api/billing/ { \
        proxy_pass http://auth:8086/api/billing/; \
        proxy_http_version 1.1; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
    } \
    location / { try_files $uri $uri/ /index.html; } \
    location ~* \\.(js|css|png|ico|woff2?)$ { expires 1y; include /etc/nginx/security-headers.conf; add_header Cache-Control "public, immutable"; } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
