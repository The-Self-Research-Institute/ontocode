# Build the standalone React (webview-src) app
FROM node:22-alpine AS builder

WORKDIR /app

# Extension manifest (app version for __APP_VERSION__) + webview package files
COPY ontology-vscode-extension/package.json ./extension-package.json
COPY ontology-vscode-extension/webview-src/package*.json ./

# Install dependencies
RUN npm config set fetch-retries 10 && \
    npm config set fetch-retry-mintimeout 10000 && \
    npm config set fetch-retry-maxtimeout 300000 && \
    npm config set fetch-timeout 300000 && \
    npm ci

# Copy webview source
COPY ontology-vscode-extension/webview-src ./

# Build production bundle (reads .env.production for VITE_CLOUD_GATEWAY_URL)
RUN npm run build

# ── Runtime: nginx serving static files ──────────────────────────────────────
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx config for SPA routing
RUN echo 'server { \
    listen 3000; \
    listen [::]:3000; \
    root /usr/share/nginx/html; \
    index index.html; \
    location /api/billing/ { \
        proxy_pass http://auth:8086/api/billing/; \
        proxy_http_version 1.1; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
    } \
    location / { try_files $uri $uri/ /index.html; } \
    location ~* \\.(js|css|png|ico|woff2?)$ { expires 1y; add_header Cache-Control "public, immutable"; } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
