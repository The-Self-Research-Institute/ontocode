# OIDC Configuration — Keycloak only
# Copy this file to .env and fill in your Keycloak credentials

# ================================
# Keycloak
# ================================
# Redirect URI: http://localhost:8086/login/oauth2/code/keycloak
OIDC_KEYCLOAK_CLIENT_ID=ontocode-auth
OIDC_KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
OIDC_KEYCLOAK_ISSUER_URI=http://localhost:9080/realms/ontocode

# ================================
# GitHub
# ================================
# Get credentials from: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8086/login/oauth2/code/github
OIDC_GITHUB_ENABLED=false
OIDC_GITHUB_CLIENT_ID=your-github-client-id
OIDC_GITHUB_CLIENT_SECRET=your-github-client-secret

# ================================
# Production Settings
# ================================
# For production, use HTTPS and update:
# - OIDC_BASE_URL=https://your-domain.com
# - Update all redirect URIs in provider configurations
# - Use secure secret management (AWS Secrets Manager, Azure Key Vault, etc.)
