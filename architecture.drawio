        </mxCell>
        <mxCell id="cd-plugin-c1" value="&lt;b&gt;Plugin Registry&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;List · install · remove&lt;br/&gt;Plugin manifest validation&lt;br/&gt;Version tracking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cd-plugin-c2" value="&lt;b&gt;NPM Resolver&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Resolves plugin packages&lt;br/&gt;from the NPM registry&lt;br/&gt;or local tarballs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="240" y="700" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cd-plugin-c3" value="&lt;b&gt;Sandboxed Executor&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Runs plugin code in isolation&lt;br/&gt;Plugin init container&lt;br/&gt;Resource limits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="815" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cd-plugin-c4" value="&lt;b&gt;Update Checker&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Periodic version checks&lt;br/&gt;against NPM&lt;br/&gt;Surfaces updates to client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="240" y="815" width="180" height="100" as="geometry" />
        </mxCell>
        <!-- ═══════════════════ SWRL SERVICE PANEL ═══════════════════ -->
        <mxCell id="cd-swrl-panel" value="&lt;b&gt;&lt;font color=&quot;#1a5c1a&quot; style=&quot;font-size:14px&quot;&gt;SWRL SERVICE&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Java · port 8083&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;arcSize=3;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="450" y="650" width="380" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cd-swrl-c1" value="&lt;b&gt;Rule Parser&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Parses SWRL rule syntax&lt;br/&gt;Produces internal rule AST&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="470" y="700" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cd-swrl-c2" value="&lt;b&gt;Drools Inference Engine&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Translates SWRL → Drools rules&lt;br/&gt;Forward-chaining inference over facts&lt;br/&gt;Returns inferred triples to OWL Editor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="470" y="775" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cd-swrl-c3" value="&lt;b&gt;Rule Validator&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Syntax and semantic validation&lt;br/&gt;Detects unsatisfiable / trivial rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="470" y="870" width="340" height="65" as="geometry" />
        </mxCell>
        <!-- ═══════════════════ NOTES ═══════════════════ -->
        <mxCell id="cd-notes" value="&lt;b&gt;Notes on this diagram&lt;/b&gt;&lt;hr/&gt;Components inside each container are grouped by &lt;b&gt;responsibility&lt;/b&gt;, not by file. Individual Spring controllers and services are listed inside each component box; refer to the source tree for the full set of classes per group.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Container-level interactions&lt;/b&gt; (Auth ↔ OWL Editor, Auth ↔ Stripe, etc.) are shown on &lt;b&gt;Page 2 (Container View)&lt;/b&gt;. This page intentionally omits cross-container arrows to keep each panel readable.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Cross-cutting&lt;/b&gt; boxes hold filters, exception handlers, and observability hooks that apply across all controllers in the same container." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="650" width="774" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
