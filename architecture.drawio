        </mxCell>
        <!-- Actors (people) -->
        <mxCell id="sc-actor-owner" value="&lt;b&gt;Workspace Owner&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;creates workspaces&lt;br/&gt;manages billing&lt;/font&gt;" style="shape=umlActor;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;" vertex="1" parent="1">
          <mxGeometry x="190" y="240" width="40" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sc-actor-admin" value="&lt;b&gt;Workspace Admin&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;invited collaborator&lt;br/&gt;editor on shared projects&lt;/font&gt;" style="shape=umlActor;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;" vertex="1" parent="1">
          <mxGeometry x="190" y="420" width="40" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sc-actor-member" value="&lt;b&gt;Workspace Member&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;viewer / read-only&lt;br/&gt;auto-added by visibility&lt;/font&gt;" style="shape=umlActor;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;" vertex="1" parent="1">
          <mxGeometry x="190" y="600" width="40" height="60" as="geometry" />
        </mxCell>
        <!-- Ontocode (the whole system, single box) -->
        <mxCell id="sc-ontocode" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;ONTOCODE&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;Collaborative OWL/RDF ontology editor&lt;/i&gt;&lt;hr/&gt;&lt;br/&gt;Workspace + project management&lt;br/&gt;Class · property · individual editing&lt;br/&gt;HermiT reasoner + SWRL rules&lt;br/&gt;Real-time multi-user collaboration&lt;br/&gt;Plugin extensibility&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Accessed via:&lt;/b&gt;&amp;nbsp;VSCode extension&amp;nbsp;·&amp;nbsp;React web app&amp;nbsp;·&amp;nbsp;standalone browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="240" width="540" height="400" as="geometry" />
        </mxCell>
        <!-- External services -->
        <mxCell id="sc-stripe" value="&lt;b style=&quot;font-size:14px&quot;&gt;Stripe&lt;/b&gt;&lt;hr/&gt;&lt;i&gt;Payment processor&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Checkout sessions&lt;br/&gt;Subscription lifecycle&lt;br/&gt;Webhook callbacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1240" y="260" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sc-smtp" value="&lt;b style=&quot;font-size:14px&quot;&gt;SMTP / Email Provider&lt;/b&gt;&lt;hr/&gt;&lt;i&gt;Transactional email&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Workspace invitations&lt;br/&gt;Billing alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1240" y="460" width="270" height="140" as="geometry" />
        </mxCell>
        <!-- Actor → Ontocode arrows -->
        <mxCell id="sc-a1" value="manages workspaces&lt;br/&gt;&amp; billing" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;fontSize=10;endArrow=block;endFill=1;" edge="1" source="sc-actor-owner" target="sc-ontocode" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sc-a2" value="edits ontologies&lt;br/&gt;(invited via email)" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;endArrow=block;endFill=1;" edge="1" source="sc-actor-admin" target="sc-ontocode" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sc-a3" value="views shared projects&lt;br/&gt;(read-only)" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;fontSize=10;endArrow=block;endFill=1;" edge="1" source="sc-actor-member" target="sc-ontocode" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Ontocode ↔ Stripe -->
        <mxCell id="sc-a4" value="checkout sessions /&lt;br/&gt;subscription mgmt" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;fontSize=10;endArrow=block;endFill=1;" edge="1" source="sc-ontocode" target="sc-stripe" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sc-a5" value="webhook events&lt;br/&gt;(async)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;fontSize=10;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" source="sc-stripe" target="sc-ontocode" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Ontocode → SMTP -->
        <mxCell id="sc-a6" value="invitation emails,&lt;br/&gt;billing alerts" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;endArrow=block;endFill=1;" edge="1" source="sc-ontocode" target="sc-smtp" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Legend -->
        <mxCell id="sc-legend" value="&lt;b&gt;Arrow conventions&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;━━━━━ ▶&lt;/b&gt;&amp;nbsp;&amp;nbsp;synchronous request (HTTP / WebSocket)&lt;br/&gt;&lt;b style=&quot;color:#b85450&quot;&gt;-  -  -  -  -  ▶&lt;/b&gt;&amp;nbsp;&amp;nbsp;asynchronous callback (Stripe webhook)&lt;br/&gt;&lt;br/&gt;Stick-figure icons mark &lt;b&gt;people&lt;/b&gt; (actors); rounded boxes mark &lt;b&gt;software systems&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="730" width="460" height="150" as="geometry" />
        </mxCell>
        <!-- Notes -->
        <mxCell id="sc-notes" value="&lt;b&gt;Key external dependencies&lt;/b&gt;&lt;hr/&gt;&lt;b&gt;Stripe&lt;/b&gt; handles all payment processing. Ontocode never sees raw card data. Subscriptions flip the workspace plan from FREE → PRO / ENTERPRISE via the webhook callback. Enterprise-domain accounts bypass Stripe entirely (auto-ENTERPRISE).&lt;br/&gt;&lt;br/&gt;&lt;b&gt;SMTP&lt;/b&gt; is outbound email for workspace invitations and billing notifications. Configured per deployment in &lt;i&gt;SystemSettings.smtpHost / Port / User / Password&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="730" width="500" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
