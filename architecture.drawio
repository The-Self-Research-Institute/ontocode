  <diagram id="auth-billing-flow" name="5. Auth &amp; Billing Flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="2" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;ONTOCODE — Auth &amp;amp; Billing Flow&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="18" width="520" height="36" as="geometry" />
        </mxCell>
        <!-- ── LOGIN FLOW ── -->
        <mxCell id="lf0" value="&lt;b&gt;LOGIN FLOW&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lf1" value="1. POST /api/auth/login&lt;br/&gt;{email, password}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="92" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lf2" value="2. Verify bcrypt password&lt;br/&gt;Check enterprise domain bypass&lt;br/&gt;Resolve effective plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="172" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lf3" value="3. Return JWT (no workspace)&lt;br/&gt;+ user profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="262" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lf4" value="4. POST /api/workspaces/{id}/select&lt;br/&gt;(picks workspace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="342" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lf5" value="5. Return workspace-scoped JWT&lt;br/&gt;Claims: workspaceId, role,&lt;br/&gt;plan, billingStatus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="422" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lf6" value="6. All subsequent API calls use&lt;br/&gt;workspace JWT in Authorization header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="512" width="210" height="50" as="geometry" />
        </mxCell>
        <!-- Login flow arrows -->
        <mxCell id="lfa1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="lf1" target="lf2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lfa2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="lf2" target="lf3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lfa3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="lf3" target="lf4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lfa4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="lf4" target="lf5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lfa5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="lf5" target="lf6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ── BILLING FLOW ── -->
        <mxCell id="bf0" value="&lt;b&gt;BILLING FLOW (Stripe)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="250" height="24" as="geometry" />
        </mxCell>
        <mxCell id="bf1" value="1. POST /api/billing/checkout&lt;br/&gt;{planName, interval, workspaceId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="92" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bf2" value="2. Create Stripe Checkout Session&lt;br/&gt;(or SetupIntent for free trial)&lt;br/&gt;Return {checkoutUrl}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="172" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bf3" value="3. User completes payment on Stripe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="262" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bf4" value="4. Stripe fires webhook →&lt;br/&gt;POST /api/billing/webhook&lt;br/&gt;Events: checkout.session.completed,&lt;br/&gt;invoice.payment_succeeded,&lt;br/&gt;customer.subscription.deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="332" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bf5" value="5. Auth updates User + Workspace:&lt;br/&gt;subscriptionPlanName, status,&lt;br/&gt;currentPeriodEnd, stripeSubId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="442" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bf6" value="6. Client calls GET /api/billing/subscription&lt;br/&gt;(enterprise bypass → immediate active)&lt;br/&gt;→ JWT refresh with new plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="532" width="240" height="60" as="geometry" />
        </mxCell>
        <!-- Billing flow arrows -->
        <mxCell id="bfa1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="bf1" target="bf2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bfa2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="bf2" target="bf3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bfa3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="bf3" target="bf4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bfa4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="bf4" target="bf5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bfa5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="bf5" target="bf6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ── INVITE FLOW ── -->
        <mxCell id="if0" value="&lt;b&gt;WORKSPACE INVITE FLOW&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="640" y="60" width="280" height="24" as="geometry" />
        </mxCell>
        <mxCell id="if1" value="1. POST /api/workspaces/{id}/invite&lt;br/&gt;{email, role: ADMIN|MEMBER}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="92" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if2" value="2. Create Invitation (token=UUID)&lt;br/&gt;Send invite email via SMTP&lt;br/&gt;with /accept-invite?token= link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="172" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="if3" value="3. Invitee clicks link →&lt;br/&gt;POST /api/invitations/accept&lt;br/&gt;{token, accepterEmail}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="262" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="if4" value="4. Add user to Workspace.members&lt;br/&gt;with invited role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="352" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="if5" value="5. Auto-add to projects:&lt;br/&gt;ADMIN → EDITOR on all non-PRIVATE&lt;br/&gt;MEMBER → VIEWER on WORKSPACE-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="432" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="if6" value="6. clearLastOpenedProjectState()&lt;br/&gt;Redirect to workspace selection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="522" width="250" height="50" as="geometry" />
        </mxCell>
        <!-- Invite flow arrows -->
        <mxCell id="ifa1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="if1" target="if2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ifa2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="if2" target="if3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ifa3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="if3" target="if4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ifa4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="if4" target="if5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ifa5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="if5" target="if6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ── COLLAB FLOW ── -->
        <mxCell id="cf0" value="&lt;b&gt;REAL-TIME COLLABORATION (WebSocket)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="60" width="380" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cf1" value="1. Client connects via SockJS/STOMP&lt;br/&gt;wss://gateway/ws/ontology-editor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="92" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cf2" value="2. Subscribe to project topic&lt;br/&gt;/topic/project/{projectId}/updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="172" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cf3" value="3. Editor sends mutation&lt;br/&gt;/app/ontology/update&lt;br/&gt;{projectId, operation, data}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="252" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cf4" value="4. OWL Editor persists to Fuseki&lt;br/&gt;via SPARQL update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="342" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cf5" value="5. Broadcasts IMPORT_COMPLETED event&lt;br/&gt;to all subscribers on project topic&lt;br/&gt;(including viewers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="422" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cf6" value="6. All connected clients reload&lt;br/&gt;ontology from Fuseki" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="512" width="270" height="50" as="geometry" />
        </mxCell>
        <!-- Collab flow arrows -->
        <mxCell id="cfa1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="cf1" target="cf2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cfa2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="cf2" target="cf3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cfa3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="cf3" target="cf4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cfa4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="cf4" target="cf5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cfa5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="cf5" target="cf6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
