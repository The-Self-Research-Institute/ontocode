        <mxCell id="cd-owl-c8" value="&lt;b&gt;Visualization&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GraphViewController · class graph&lt;br/&gt;VisualizationController · custom views&lt;br/&gt;Vis-network rendering (client-side)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
