        <mxCell id="cd-plugin-panel" value="&lt;b&gt;&lt;font color=&quot;#1a5c1a&quot; style=&quot;font-size:14px&quot;&gt;PLUGIN SERVICE&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Node.js · port 3001&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;arcSize=3;pointerEvents=0;" vertex="1" parent="1">
