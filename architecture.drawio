          <mxGeometry height="160" width="223" x="970" y="643" as="geometry" />
        </mxCell>
        <mxCell id="410" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Project Visibility&lt;/b&gt;&lt;hr/&gt;PRIVATE — owner only, never auto-added&lt;br/&gt;WORKSPACE — all workspace members,&lt;br/&gt;&amp;nbsp;&amp;nbsp;new members auto-added as VIEWER&lt;br/&gt;SPECIFIC — hand-picked set,&lt;br/&gt;&amp;nbsp;&amp;nbsp;new ADMINs auto-added as EDITOR&lt;br/&gt;&lt;br/&gt;null (legacy) → treated as SPECIFIC" vertex="1">
          <mxGeometry height="130" width="223" x="970" y="822" as="geometry" />
