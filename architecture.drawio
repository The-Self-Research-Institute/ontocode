        <mxCell id="cd-owl-c9" value="&lt;b&gt;Backend Services&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GraphDBDatasetService · per-project SPARQL endpoint&lt;br/&gt;OntologyQueryService · cached SELECT helpers&lt;br/&gt;FusekiClient · HTTP bridge to Fuseki&lt;br/&gt;WebSocketBroadcaster&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
