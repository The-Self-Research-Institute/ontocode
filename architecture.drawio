        </mxCell>
        <mxCell id="cd-owl-c7" value="&lt;b&gt;Collaboration (WebSocket)&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CollaborativeEditController · STOMP messages&lt;br/&gt;ActiveConnectionsController · presence&lt;br/&gt;WorkspaceEventController · workspace-wide events&lt;br/&gt;Topic: /topic/project/{id}/updates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
