        <mxCell id="cd-owl-c6" value="&lt;b&gt;Merge &amp;amp; Import&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366&quot;/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OntologyMergeController · conflict detect&lt;br/&gt;ImportQueueController · async queue&lt;br/&gt;ImportWorkerController · worker pool&lt;br/&gt;Uses OWLAPI for merge engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
