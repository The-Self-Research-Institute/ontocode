  <diagram id="system-context" name="1. System Context">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="sc-title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;ONTOCODE — System Context&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="567" y="30" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sc-subtitle" value="&lt;i&gt;C4 Level 1 — actors and external services. Drill into Page 2 for the internal containers.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
