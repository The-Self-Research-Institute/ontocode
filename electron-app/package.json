{
  "name": "ontocode-desktop",
  "version": "1.0.0",
  "description": "OntoCode Ontology Editor – Desktop (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-web": "cd ../ontology-vscode-extension/webview-src && npm run build",
    "dist": "npm run build-web && electron-builder",
    "pack": "npm run build-web && electron-builder --dir"
  },
  "keywords": ["ontology", "owl", "editor"],
  "author": "OntoCode",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.ontocode.desktop",
    "productName": "OntoCode",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "../ontology-vscode-extension/webview-src/dist/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "../ontology-vscode-extension/webview-src/dist/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "../ontology-vscode-extension/webview-src/dist/favicon.ico"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
