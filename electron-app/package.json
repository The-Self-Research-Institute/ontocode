{
  "name": "ontocode-desktop",
  "version": "1.1.0-beta.4",
  "description": "OntoCode Ontology Editor – Desktop (Electron + bundled backend)",
  "homepage": "https://ontocode.selfresearch.org",
  "author": "OntoCode",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env ELECTRON_IS_DEV=1 electron .",
    "start:dev:win": "set ELECTRON_IS_DEV=1 && electron .",
    "build-web": "cd ../ontology-vscode-extension/webview-src && npm run build:electron",
    "prepare-resources": "node scripts/prepare-resources.js",
    "dist": "npm run build-web && electron-builder",
    "dist:win": "npm run build-web && electron-builder --win",
    "dist:mac": "npm run build-web && electron-builder --mac",
    "dist:linux": "npm run build-web && electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "ontology",
    "owl",
    "editor",
    "desktop",
    "offline"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9"
  }
}
