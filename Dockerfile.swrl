# Multi-stage build for SWRL Rules Engine Service
# NOTE: SWRL service MUST use Java 17 due to SWRLAPI/Drools/MVEL incompatibility with Java 21
# See ontology-swrl/JAVA_COMPATIBILITY.md for details
FROM maven:3.9-eclipse-temurin-17-alpine AS build

WORKDIR /build

# Copy parent pom first for better caching
COPY pom.xml .

# Copy all service directories (Maven needs them for module resolution even if not all are used)
COPY shared/ ./shared/
COPY ontology-auth/ ./ontology-auth/
COPY ontology-gateway/ ./ontology-gateway/
COPY ontology-editor/ ./ontology-editor/
COPY ontology-swrl/ ./ontology-swrl/
COPY ontology-plugin-service/ ./ontology-plugin-service/

# Build shared modules first (these are dependencies for all services)
RUN --mount=type=cache,target=/root/.m2 \
    mvn -Dhttp.keepAlive=false \
        -Dmaven.wagon.http.retryHandler.count=10 \
        -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 \
        clean install -pl shared/common-models,shared/common-utils -DskipTests -B -ntp

# Build SWRL module - package goal includes spring-boot:repackage automatically
RUN --mount=type=cache,target=/root/.m2 \
    mvn -Dhttp.keepAlive=false \
        -Dmaven.wagon.http.retryHandler.count=10 \
        -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 \
        clean package -pl ontology-swrl -DskipTests -B -ntp

# Runtime stage - MUST use Java 17 for SWRLAPI compatibility
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Add non-root user for security
RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

# Create logs directory
RUN mkdir -p /app/logs && \
    chown -R appuser:appuser /app

# Copy the built JAR (spring-boot:repackage creates executable JAR)
COPY --from=build /build/ontology-swrl/target/*.jar app.jar

USER appuser

# Expose swrl port
EXPOSE 8084

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8084/actuator/health || exit 1

# Run the application
ENTRYPOINT ["java", "-Xms256m", "-Xmx1024m", "-jar", "app.jar"]
