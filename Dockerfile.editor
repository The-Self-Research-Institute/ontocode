# Multi-stage build for Ontology Editor Service
FROM maven:3.9-eclipse-temurin-21-alpine AS build

WORKDIR /build

# Copy parent pom first for better caching
COPY pom.xml .

# Copy all service directories (Maven needs them for module resolution even if not all are used)
COPY shared/ ./shared/
COPY ontology-auth/ ./ontology-auth/
COPY ontology-gateway/ ./ontology-gateway/
COPY ontology-editor/ ./ontology-editor/
COPY ontology-swrl/ ./ontology-swrl/
COPY ontology-plugin-service/ ./ontology-plugin-service/
COPY ontology-reasoner-worker/ ./ontology-reasoner-worker/

# Build shared modules first (these are dependencies for all services)
# Uses BuildKit cache for ~/.m2 to avoid re-downloading dependencies on every build.
RUN --mount=type=cache,target=/root/.m2 \
    mvn -Dhttp.keepAlive=false -Dmaven.wagon.http.retryHandler.count=5 \
        clean install -pl shared/common-models,shared/common-utils,ontology-editor -DskipTests -B -ntp

# Runtime stage
FROM eclipse-temurin:21-jre

WORKDIR /app

# Add non-root user for security
RUN if ! getent group 1000 >/dev/null; then groupadd -g 1000 appuser; else echo "Group 1000 already exists"; fi && \
    if ! getent passwd 1000 >/dev/null; then useradd -u 1000 -g 1000 -m -s /bin/bash appuser; else echo "User 1000 already exists"; fi

# Install wget for health checks
RUN apt-get update && apt-get install -y wget && rm -rf /var/lib/apt/lists/*

# Create writable directories for data and logs
RUN mkdir -p /app/data /app/logs && \
    chown 1000:1000 /app/data /app/logs

# Copy the built JAR (spring-boot:repackage creates executable JAR)
# classifier=exec produces owlEditor-1.0.0-exec.jar (fat JAR) + owlEditor-1.0.0.jar (plain)
# Copy the exec JAR explicitly to avoid picking up the plain non-executable JAR
COPY --from=build --chown=1000:1000 /build/ontology-editor/target/*-exec.jar app.jar

USER 1000

# Expose editor port
EXPOSE 8083

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8083/actuator/health/liveness || exit 1

# Run the application — JAVA_OPTS env var overrides defaults when set in docker-compose
ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS:--Xms1g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=200} -jar app.jar"]
