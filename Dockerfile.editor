# Multi-stage build for Ontology Editor Service
FROM maven:3.9-eclipse-temurin-21-alpine AS build

WORKDIR /build

# Copy parent pom first for better caching
COPY pom.xml .

# Copy all service directories (Maven needs them for module resolution even if not all are used)
COPY shared/ ./shared/
COPY ontology-auth/ ./ontology-auth/
COPY ontology-gateway/ ./ontology-gateway/
COPY ontology-editor/ ./ontology-editor/
COPY ontology-swrl/ ./ontology-swrl/

# Build shared modules first (these are dependencies for all services)
RUN mvn clean install -pl shared/common-models,shared/common-utils -DskipTests -B -ntp

# Build editor module - package goal includes spring-boot:repackage automatically
RUN mvn clean package -pl ontology-editor -DskipTests -B -ntp

# Runtime stage
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Add non-root user for security
RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

# Create directories for data and logs
RUN mkdir -p /app/data /app/logs && \
    chown -R appuser:appuser /app

# Copy the built JAR (spring-boot:repackage creates executable JAR)
COPY --from=build /build/ontology-editor/target/*.jar app.jar

USER appuser

# Expose editor port
EXPOSE 8083

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8083/actuator/health || exit 1

# Run the application with increased memory for ontology processing
ENTRYPOINT ["java", "-Xms512m", "-Xmx2048m", "-XX:+UseG1GC", "-jar", "app.jar"]
