# Multi-stage build for OntoCode Reasoner Worker
FROM maven:3.9-eclipse-temurin-21-alpine AS build

WORKDIR /build

COPY pom.xml .
COPY shared/ ./shared/
COPY ontology-reasoner-worker/ ./ontology-reasoner-worker/

RUN --mount=type=cache,target=/root/.m2 \
    mvn -Dhttp.keepAlive=false -Dmaven.wagon.http.retryHandler.count=5 \
        clean install -pl shared/common-utils -DskipTests -B -ntp

RUN --mount=type=cache,target=/root/.m2 \
    mvn -Dhttp.keepAlive=false -Dmaven.wagon.http.retryHandler.count=5 \
        clean package -pl ontology-reasoner-worker -DskipTests -B -ntp

FROM eclipse-temurin:21-jre
WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/ontology-reasoner-worker/target/*-exec.jar app.jar

EXPOSE 8088

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -sf http://localhost:8088/actuator/health/liveness || exit 1

ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS:--Xms2g -Xmx8g -XX:+UseG1GC -XX:MaxGCPauseMillis=200} -jar app.jar"]
