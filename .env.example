# OntoCode Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# GraphDB License
# ========================================
# Path to your GraphDB license file (relative to workspace root)
# Download from Ontotext and place the .lic file in the workspace
GDB_LICENSE_FILE=CORETOPIA_GRAPHDB_FREE_v11.1.license
GDB_LICENSE_PATH=.
# Or use the absolute path to license file
# GDB_LICENSE_PATH=/path/to/graphdb-license.lic

# ========================================
# Database Configuration
# ========================================
MONGODB_URI=mongodb://admin:changeme@mongo:27017/ontocode?authSource=admin
MONGODB_DATABASE=ontocode

GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=ontocode

# ========================================
# Application Configuration
# ========================================
BASE_URL=http://localhost:8083
AUTH_SERVICE_URL=http://localhost:8086
GATEWAY_URL=http://localhost:8082

# ========================================
# Spring Boot Configuration
# ========================================
SPRING_PROFILES_ACTIVE=dev

# ========================================
# Security
# ========================================
JWT_SECRET=your-secret-key-change-this-in-production

# ========================================
# Email Configuration (Optional)
# ========================================
EMAIL_ENABLED=true
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here

# ========================================
# Data Directory
# ========================================
DATA_DIR=./data
