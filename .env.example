# OntoCode Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# Database Configuration
 ========================================
# Fuseki / Apache Jena Configuration
# ========================================
# Use localhost when running the editor service outside Docker (e.g. mvn spring-boot:run)
# Docker compose sets these to http://fuseki:3030/... automatically for container-to-container
FUSEKI_QUERY_ENDPOINT=http://localhost:3030/ontocode/query
FUSEKI_UPDATE_ENDPOINT=http://localhost:3030/ontocode/update
FUSEKI_GSP_ENDPOINT=http://localhost:3030/ontocode/data
FUSEKI_ADMIN_PASSWORD=admin# ========================================
MONGODB_URI=mongodb://admin:changeme@mongo:27017/ontocode?authSource=admin
MONGODB_DATABASE=ontocode

#

# ========================================
# Application Configuration
# ========================================
# BASE_URL is the public web UI origin (used in invitation and password-reset links). With default compose webapp: port 3000.
BASE_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:8086
# Gateway listens on port 80 in docker-compose.yml / docker-compose.production.yml
GATEWAY_URL=http://localhost

# HTTP timeouts for uploads up to 1GB (gateway + editor; default 2 hours)
GATEWAY_HTTP_RESPONSE_TIMEOUT=7200s
ONTOLOGY_HTTP_TIMEOUT_MS=7200000
ONTOLOGY_HTTP_TIMEOUT_SECONDS=7200s

# ========================================
# Spring Boot Configuration
# ========================================
SPRING_PROFILES_ACTIVE=dev

# ========================================
# Security
# ========================================
# Must be valid Base64, decoding to at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=ZGV2ZWxvcG1lbnQtb250b2NvZGUtand0LXNlY3JldC1mb3ItbG9jYWwtZGV2ZWxvcG1lbnQ=

# ========================================
# Email Configuration (Optional)
# ========================================
EMAIL_ENABLED=true
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here

# # ========================================
# # Jira Integration (Optional - for issue reporting)
# # ========================================
# # Enable/disable Jira integration
# JIRA_ENABLED=true
# # Your Jira Cloud instance URL (e.g., https://yourcompany.atlassian.net)
# JIRA_CLOUD_URL=https://yourcompany.atlassian.net
# # Email address associated with Jira account
# JIRA_USER_EMAIL=you@example.com
# # Jira API token (create at: Account Settings > Security > API Tokens)
# JIRA_API_TOKEN=your_jira_api_token_here
# # Project key where bugs will be created (e.g., ONTO)
# JIRA_PROJECT_KEY=DEV
# # Epic key under which bugs will be created (e.g., ONTO-123)
# JIRA_EPIC_KEY=DEV-8
# # Issue type for created issues (e.g., Task, Bug, Story)
# JIRA_ISSUE_TYPE=Task


JIRA_ENABLED=true
JIRA_CLOUD_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=TSRI
JIRA_EPIC_KEY=TSRI-103
JIRA_ISSUE_TYPE=Task

# ========================================
# Billing Email Reminders
# ========================================
# Set to false to disable all billing reminder emails
BILLING_REMINDER_ENABLED=true
# Comma-separated days before trial/subscription expiry to send reminder emails (matches auth service)
BILLING_REMINDER_DAYS_BEFORE_LIST=15,7,1
# Cron expression for when the reminder job runs (default: daily 9 AM)
BILLING_REMINDER_CRON=0 0 9 * * *

# ========================================
# Subscription Expiry Check & Auto-Renewal
# ========================================
# Set to false to disable the periodic expiry check
BILLING_EXPIRY_CHECK_ENABLED=true
# How often to check for expired subscriptions in ms (default: 6 hours)
BILLING_EXPIRY_CHECK_INTERVAL_MS=21600000
# Set to false to disable the auto-renewal job entirely
BILLING_AUTORENEWAL_ENABLED=true
# Cron expression for when auto-renewal runs (default: daily 2 AM)
BILLING_AUTORENEWAL_CRON=0 0 2 * * ?

# Cron expression for expiring stale pending invitations (default: daily 2 AM)
INVITATION_CLEANUP_CRON=0 0 2 * * *

# ========================================
# Storage Limits per Plan (GB)
# ========================================
STORAGE_LIMIT_FREE_GB=10
STORAGE_LIMIT_PRO_GB=100
# Enterprise is always unlimited
# Workspace Member Limits
PLAN_FREE_MAX_MEMBERS=3
PLAN_PRO_MAX_MEMBERS=10
PLAN_ENTERPRISE_MAX_MEMBERS=2147483647

# Plan Pricing Defaults (Initial seed values for database)
PLAN_PRO_MONTHLY_PRICE=29
PLAN_PRO_ANNUAL_DISCOUNT_PERCENT=17
PLAN_ENTERPRISE_MONTHLY_PRICE=99
PLAN_ENTERPRISE_ANNUAL_DISCOUNT_PERCENT=20

# ========================================
# Data Directory
# ========================================
DATA_DIR=./data

# ========================================
# Stripe Payment Configuration
# ========================================
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use sk_test_... keys for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Trial period duration in days (default: 14)
STRIPE_TRIAL_PERIOD_DAYS=14

# Get your webhook secret from: Stripe Dashboard > Webhooks > Your endpoint > Signing secret
# For local testing, use: stripe listen --forward-to localhost:8086/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs — create products/prices in Stripe Dashboard > Products
# Format: price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id_here
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id_here
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly_id_here
STRIPE_PRICE_ENTERPRISE_YEARLY=price_enterprise_yearly_id_here

