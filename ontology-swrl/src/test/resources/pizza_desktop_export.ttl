                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Test: SWRL counterpart of GCI-1. Fires only on asserted named toppings (DL-safe), so it finds fewer pizzas than MeatyPizza." ;
