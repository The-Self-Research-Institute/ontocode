<http://www.semanticweb.org/pizzatutorial/ontologies/2020/PizzaTutorial> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/pizzatutorial/ontologies/2020/PizzaTutorial#hasBase
:hasBase rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/pizzatutorial/ontologies/2020/PizzaTutorial#hasIngredient
:hasIngredient rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/pizzatutorial/ontologies/2020/PizzaTutorial#hasSpiciness
:hasSpiciness rdf:type owl:ObjectProperty .


