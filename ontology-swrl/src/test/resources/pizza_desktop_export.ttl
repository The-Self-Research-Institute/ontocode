###  http://www.semanticweb.org/pizzatutorial/ontologies/2020/PizzaTutorial#TestThinBase1
:TestThinBase1 rdf:type owl:NamedIndividual ,
                        :ThinAndCrispyBase .


###  http://www.semanticweb.org/pizzatutorial/ontologies/2020/PizzaTutorial#TestTunaTopping1
:TestTunaTopping1 rdf:type owl:NamedIndividual ,
                           :TunaTopping .


###  http://www.semanticweb.org/pizzatutorial/ontologies/2020/PizzaTutorial#Waiter1
:Waiter1 rdf:type owl:NamedIndividual ,
                  :Employee ;
         :hasPhone "123-234-3434" ;
         :ssn "123456666" .


###  http://www.semanticweb.org/pizzatutorial/ontologies/2020/PizzaTutorial#Waiter2
:Waiter2 rdf:type owl:NamedIndividual ,
                  :Employee .


#################################################################
#    Rules
#################################################################

:c rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:s rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:p rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:d rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:np rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:spr rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:e rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:s1 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:s2 rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:t rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:cal rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Test: customer prefers something milder than Hot but purchased a SpicyPizza. Uses inferred isMilderThan (inverse of transitive isSpicierThan) and inferred SpicyPizza." ;
   rdfs:label "SpicinessMismatchRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Customer ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :c
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasSpicinessPreference ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :s
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :isMilderThan ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :s ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :Hot
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :purchasedPizza ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :p
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#classPredicate> :SpicyPizza ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :p
                                                                                                 ] ;
                                                                                       rdf:rest rdf:nil
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :SpicinessMismatchCustomer ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :c
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Test/data quality: a discount above 1.0 (100%) is invalid." ;
   rdfs:label "InvalidDiscountRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Customer ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :c
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasDiscount ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :d
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#BuiltinAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#builtin> <http://www.w3.org/2003/11/swrlb#greaterThan> ;
                                                                             <http://www.w3.org/2003/11/swrl#arguments> [ rdf:type rdf:List ;
                                                                                                                          rdf:first :d ;
                                                                                                                          rdf:rest [ rdf:type rdf:List ;
                                                                                                                                     rdf:first 1.0 ;
                                                                                                                                     rdf:rest rdf:nil
                                                                                                                                   ]
                                                                                                                        ]
                                                                           ] ;
                                                                 rdf:rest rdf:nil
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :InvalidDiscountCustomer ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :c
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "Provide a special discount for customers who prefer hot pizzas" ;
   rdfs:label "LessSpicyDiscountRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
