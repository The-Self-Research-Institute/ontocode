{
  "name": "ontocode-extension",
  "displayName": "OntoCode OWL Editor",
  "description": "Edit OWL files with authentication and web-based interface",
  "version": "1.0.0",
  "publisher": "self",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Languages",
    "Formatters"
  ],
  "keywords": [
    "owl",
    "ontology",
    "semantic web",
    "rdf",
    "knowledge graph"
  ],
  "activationEvents": [
    "onCommand:ontocode.edit",
    "onCommand:ontocode.editLargeFile",
    "onCommand:ontocode.logout",
    "onCommand:ontocode.insertCitation",
    "onCommand:ontocode.showCollaborationStatus",
    "onLanguage:owl",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "extensionDependencies": [
    "SelfResearchInstitute.sci2code"
  ],
  "contributes": {
    "webviews": [
      {
        "viewType": "ontocodeEditor",
        "displayName": "OntoCode Editor",
        "when": "true"
      }
    ],
    "commands": [
      {
        "command": "ontocode.edit",
        "title": "Edit with OntoCode",
        "category": "OntoCode"
      },
      {
        "command": "ontocode.editLargeFile",
        "title": "OntoCode: Edit Ontology File",
        "category": "OntoCode"
      },
      {
        "command": "ontocode.logout",
        "title": "OntoCode: Logout",
        "category": "OntoCode"
      },
      {
        "command": "ontocode.insertCitation",
        "title": "Insert Citation",
        "category": "OntoCode"
      },
      {
        "command": "ontocode.showCollaborationStatus",
        "title": "OntoCode: Show Collaboration Status",
        "category": "OntoCode"
      },
      {
        "command": "ontocode.configureZotero",
        "title": "OntoCode: Configure Zotero Integration",
        "category": "OntoCode"
      },
      {
        "command": "ontocode.testZoteroConnection",
        "title": "OntoCode: Test Zotero Connection",
        "category": "OntoCode"
      },
      {
        "command": "ontocode.testInvitationFlow",
        "title": "OntoCode: Test Invitation Flow",
        "category": "OntoCode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ontocode.edit",
          "when": "resourceLangId == owl"
        },
        {
          "command": "ontocode.editLargeFile",
          "when": "resourceLangId == owl"
        }
      ],
      "editor/context": [
        {
          "command": "ontocode.insertCitation",
          "when": "resourceExtname =~ /\\.(owl|ttl|rdf|n3)$/",
          "group": "ontocode"
        },
        {
          "command": "ontocode.editLargeFile",
          "when": "resourceFilename =~ /\\.(owl|ttl|rdf)$/i",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ontocode.insertCitation",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus && resourceExtname =~ /\\.(owl|ttl|rdf|n3)$/"
      }
    ],
    "languages": [
      {
        "id": "owl",
        "aliases": [
          "OWL",
          "owl"
        ],
        "extensions": [
          ".owl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "OntoCode",
      "properties": {
        "ontocode.zotero.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your Zotero API key (get from https://www.zotero.org/settings/keys)",
          "markdownDescription": "Your Zotero API key. Get one from [Zotero Settings](https://www.zotero.org/settings/keys)"
        },
        "ontocode.zotero.userId": {
          "type": "string",
          "default": "",
          "description": "Your Zotero user ID (found in API key page)",
          "markdownDescription": "Your Zotero user ID. Found on your [API keys page](https://www.zotero.org/settings/keys)"
        },
        "ontocode.zotero.libraryType": {
          "type": "string",
          "enum": [
            "user",
            "group"
          ],
          "default": "user",
          "description": "Type of Zotero library (user or group)"
        },
        "ontocode.zotero.groupId": {
          "type": "string",
          "default": "",
          "description": "Group ID if using a group library"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle:extension",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "build-webview": "cd webview-src && npm run build",
    "compile-web": "webpack --config webpack.config.js --mode development --watch",
    "test-web": "npm run bundle:web && vscode-test-web --browserType=chromium --extensionDevelopmentPath=./ .",
    "test-web:server": "npm run bundle:web && vscode-test-web --browserType=none --port=3000 --host=0.0.0.0 --extensionDevelopmentPath=./ .",
    "test-web:dev": "vscode-test-web --browserType=chromium --port=3000 --extensionDevelopmentPath=./ .",
    "dev-webview": "cd webview-src && npm run dev",
    "bundle:extension": "webpack --config webpack.extension.js --mode production",
    "bundle:webview": "cd webview-src && npm run build",
    "bundle:web": "webpack --config webpack.config.js --mode production",
    "bundle:all": "npm run bundle:webview && npm run bundle:extension && npm run bundle:web",
    "test:selfhosted": "cross-env ENV_FILE=.env.selfhosted-test npm run bundle:all",
    "test:cloud": "cross-env ENV_FILE=.env.cloud-test npm run bundle:all",
    "analyze:extension": "cross-env ANALYZE=true webpack --config webpack.extension.js --mode production",
    "analyze:web": "cross-env ANALYZE=true webpack --config webpack.config.js --mode production",
    "check:size": "node check-bundle-size.js",
    "package": "vsce package",
    "package:check": "vsce package && node -e \"const fs=require('fs');const files=fs.readdirSync('.');const vsix=files.find(f=>f.endsWith('.vsix'));if(vsix){const stats=fs.statSync(vsix);const mb=(stats.size/(1024*1024)).toFixed(2);console.log(`\\n📦 VSIX Size: ${mb} MB (${stats.size.toLocaleString()} bytes)`);console.log(`⚠️  Default limit: 25 MB`);console.log(`🔴 Hard limit: 50 MB\\n`);if(stats.size>50*1024*1024)console.log('❌ EXCEEDS HARD LIMIT!');else if(stats.size>25*1024*1024)console.log('⚠️  EXCEEDS DEFAULT LIMIT');}else{console.log('No .vsix file found');}\""
  },
  "devDependencies": {
    "@types/form-data": "^2.2.1",
    "@types/node": "16.x",
    "@types/sockjs-client": "^1.5.4",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-web": "^0.0.80",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "eslint": "^8.28.0",
    "html-webpack-plugin": "^5.6.5",
    "https-browserify": "^1.0.0",
    "mini-css-extract-plugin": "^2.9.4",
    "pako": "^2.1.0",
    "process": "^0.11.10",
    "readable-stream": "^2.3.8",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.4",
    "typescript": "^4.9.4",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vsce": "^2.15.0",
    "webpack": "^5.103.0",
    "webpack-bundle-analyzer": "^5.0.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.0.0",
    "axios": "^1.13.6",
    "crypto-browserify": "^3.12.1",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.5",
    "fs-extra": "^11.1.0",
    "lucide-react": "^0.525.0",
    "path-browserify": "^1.0.1",
    "sockjs-client": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Self-Research-Institute/ontocode.git"
  }
}
