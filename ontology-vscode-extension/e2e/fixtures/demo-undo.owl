<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/demo/pizza#"
     xml:base="http://example.org/demo/pizza"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://example.org/demo/pizza">
        <rdfs:label>Pizza Demo (main)</rdfs:label>
        <rdfs:comment>Small starting ontology for the undo/redo and merge demo.</rdfs:comment>
    </owl:Ontology>

    <owl:ObjectProperty rdf:about="http://example.org/demo/pizza#hasTopping">
        <rdfs:label>has topping</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/demo/pizza#Pizza"/>
        <rdfs:range rdf:resource="http://example.org/demo/pizza#PizzaTopping"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/demo/pizza#hasPrice">
        <rdfs:label>has price</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/demo/pizza#Pizza"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="http://example.org/demo/pizza#Pizza">
        <rdfs:label>Pizza</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/demo/pizza#PizzaBase">
        <rdfs:label>Pizza base</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/demo/pizza#PizzaTopping">
        <rdfs:label>Pizza topping</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/demo/pizza#Margherita">
        <rdfs:label>Margherita</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/demo/pizza#Pizza"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/demo/pizza#CheeseTopping">
        <rdfs:label>Cheese topping</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/demo/pizza#PizzaTopping"/>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/demo/pizza#TomatoTopping">
        <rdfs:label>Tomato topping</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://example.org/demo/pizza#PizzaTopping"/>
    </owl:Class>

    <owl:NamedIndividual rdf:about="http://example.org/demo/pizza#MargheritaOne">
        <rdf:type rdf:resource="http://example.org/demo/pizza#Margherita"/>
        <rdfs:label>Margherita One</rdfs:label>
    </owl:NamedIndividual>

    <owl:Class rdf:about="http://example.org/demo/pizza#Vehicle"><rdfs:label>Vehicle</rdfs:label></owl:Class>
    <owl:Class rdf:about="http://example.org/demo/pizza#Truck"><rdfs:label>Truck</rdfs:label></owl:Class>
    <owl:DatatypeProperty rdf:about="http://example.org/demo/pizza#hasCalories">
        <rdfs:label>has calories</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/demo/pizza#hasSpeed">
        <rdfs:label>has speed</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

</rdf:RDF>
