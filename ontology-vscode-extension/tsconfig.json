{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": [
      "ES2020", // Include ES2020 for Node.js environment
      "DOM" // Include DOM for browser APIs like FormData and File
    ],
    "sourceMap": true,
    "rootDir": "src", // Only compile files under 'src'
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "out" // Or "dist" if your webpack.extension.js points there
  },
  "include": [
    "src/**/*.ts" // ONLY include TypeScript files in the 'src' directory
, "webview-src/services/swrlApiService.ts"  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "webview-src" 
  ]
}