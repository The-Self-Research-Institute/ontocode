# Testing configuration for cloud pointing to localhost APIs

# Self-hosted Deployment URLs (original localhost URLs)
SELF_HOSTED_GATEWAY_URL=http://localhost:80
SELF_HOSTED_EDITOR_URL=http://localhost:80
SELF_HOSTED_PLUGIN_URL=http://localhost:8087

# Cloud Deployment URLs (points to localhost for testing)
CLOUD_GATEWAY_URL=http://localhost:80
CLOUD_EDITOR_URL=http://localhost:80
CLOUD_PLUGIN_URL=http://localhost:8087

# Default Deployment Type
DEFAULT_DEPLOYMENT_TYPE=cloud
