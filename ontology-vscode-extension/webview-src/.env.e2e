# Used by: npm run dev:e2e  (proxy API calls to production for Playwright tests)
# The apiClient will use localhost:3001 as BASE_URL so requests go through
# the Vite proxy which forwards them to the production gateway.
VITE_API_PROXY_TARGET=https://ontocodeapi.selfresearch.org
VITE_SELF_HOSTED_GATEWAY_URL=http://localhost:3001
