    "d3": "^7.9.2",
    "dompurify": "3.4.17",
    "form-data": "^4.0.4",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sockjs-client": "^1.6.1",
    "vis-network": "^10.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
